_title_asset_cache = {}


def make_title(text, width, height, dpi):
    """Scale the approved transparent rounded wordmark/halo for the opening."""
    from PIL import Image, ImageFilter
    if text != "LUMASCRIBE":
        return _title_plain(text, width, height, dpi)
    try:
        if "source" not in _title_asset_cache:
            asset = asset_path("lumascribe_title.png")
            with Image.open(asset) as image:
                _title_asset_cache["source"] = image.convert("RGBA")
        source = _title_asset_cache["source"]
    except (OSError, ValueError):
        return _title_plain(text, width, height, dpi)
    scale = min(width * .72 / source.width, height * .40 / source.height)
    image = source.resize((max(2, round(source.width * scale)),
                           max(2, round(source.height * scale))), Image.Resampling.LANCZOS)
    alpha = image.getchannel("A")
    glow = alpha.filter(ImageFilter.GaussianBlur(9 * dpi)).point(lambda v: int(v * .65))
    pos = ((width - image.width) // 2, round(height * .49 - image.height * .64))
    return image.convert("RGB"), alpha, glow, pos


def _draw_ripple(img, cx, cy, radius, alpha):
    """Three highlighted concentric rings, expanding as one transparent cluster."""
    from PIL import Image, ImageDraw, ImageFilter
    if radius < 2 or alpha <= 0:
        return
    alpha = min(1.0, alpha * 1.5)
    S, pad = 2, 16
    side = round(radius*2)+pad*2
    patch=Image.new("RGBA",(side*S,side*S),(160,231,255,0))
    d=ImageDraw.Draw(patch);c=side*S/2
    for fraction,gain in ((1.,.72),(.68,.90),(.34,1.)):
        r=radius*fraction*S
        box=(c-r,c-r,c+r,c+r)
        d.ellipse(box,outline=(85,191,235,round(190*alpha*gain)),width=7*S)
        d.ellipse((box[0]+S,box[1]+S,box[2]-S,box[3]-S),
                  outline=(244,254,255,round(245*alpha*gain)),width=3*S)
    bloom=Image.new("RGBA",patch.size,(183,240,255,0))
    bloom.putalpha(patch.getchannel("A").filter(ImageFilter.GaussianBlur(3*S)))
    bloom.alpha_composite(patch)
    patch=bloom.resize((side,side),Image.Resampling.LANCZOS)
    img.paste(patch,(round(cx-side/2),round(cy-side/2)),patch)


class IntroPlayer:
    """Opening sequence drawn frame by frame on a canvas that covers the finished window."""
    PORTRAIT_IN = (500, 2300)
    TITLE_IN = (1300, 2200)
    TITLE_OUT = (3600, 4250)
    CARD_IN = (3500, 4100)
    ROWS_START, ROW_MS = 3800, 800
    RIPPLE_START, RIPPLE_END, RIPPLE_PERIOD = 1300, 3300, 2800

    def __init__(self, root, dpi, sky, portrait, full, rows, frame_rect, sound_on, tune_ms, on_done, portrait_at=(0, 0)):
        self.root, self.dpi, self.sky, self.full = root, dpi, sky, full
        self.portrait_at = portrait_at
        self.W, self.H = sky.size
        self.portrait_rgb = portrait.convert("RGB") if portrait is not None else None
        self.portrait_alpha = portrait.getchannel("A") if portrait is not None else None
        self.rows, self.frame_rect = rows, frame_rect
        self.sound_on, self.tune_ms, self.on_done = sound_on, tune_ms, on_done
        self.title_rgb, self.title_alpha, self.glow_alpha, self.title_pos = make_title(APP_NAME.upper(), self.W, self.H, dpi)
        self.ripples = [(self.W * .79, self.H * .37, 135 * self.H / 700, 0),
                        (self.W * .36, self.H * .74, 150 * self.H / 700, 220),
                        (self.W * .73, self.H * .70, 85 * self.H / 700, 420)]
        n = len(rows)
        self.row_step = min(130.0, 900.0 / max(1, n))
        self.end = (self.ROWS_START + max(0, n - 1) * self.row_step + self.ROW_MS + 150) if n else self.CARD_IN[1] + 400
        self.voice_at = max(2000.0, tune_ms) + 80.0
        self.sound_retry_at = 0.0
        self.closed, self.job, self.photo, self.sound_stage = False, None, None, 0
        self.canvas = tk.Canvas(root, highlightthickness=0, borderwidth=0, background="#dff3fd")
        self.binds = []

    def start(self):
        from PIL import ImageTk
        self.canvas.place(x=0, y=0, relwidth=1, relheight=1)
        tk.Misc.lift(self.canvas)  # Canvas.lift would raise canvas items instead
        self.item = self.canvas.create_image(0, 0, anchor="nw")
        self._draw(0)
        self.root.update()
        try:
            self.root.attributes("-alpha", 1.0)
        except tk.TclError:
            pass
        self.t0 = time.perf_counter()
        self.binds = [("<Button-1>", self.root.bind("<Button-1>", self.skip, add="+")),
                      ("<Key>", self.root.bind("<Key>", self.skip, add="+"))]
        self.job = self.root.after(1, self._tick)

    def skip(self, event=None):
        if (time.perf_counter() - self.t0) * 1000 > 300:
            opening_sound()
            self.finish()

    def finish(self):
        if self.closed:
            return
        self.closed = True
        if self.job is not None:
            self.root.after_cancel(self.job)
        for seq, fid in self.binds:
            try:
                self.root.unbind(seq, fid)
            except tk.TclError:
                pass
        self.canvas.destroy()
        self.on_done()

    def _tick(self):
        if self.closed:
            return
        try:
            t = (time.perf_counter() - self.t0) * 1000
            if self.sound_on and self.sound_stage == 0 and t >= self.sound_retry_at:
                if opening_sound(True):
                    self.sound_stage = 1
                    self.voice_at = t + _opening_audio_cache.get("voice_ms", self.voice_at)
                    self.end = max(self.end, t + _opening_audio_cache.get("duration_ms", 0) + 200)
                else:
                    self.sound_retry_at = t + 250.0
            self._draw(t)
            if t >= self.end:
                self.finish()
                return
            self.job = self.root.after(6, self._tick)
        except Exception:
            self.finish()

    def _draw(self, t):
        from PIL import ImageTk
        self.photo = ImageTk.PhotoImage(self._compose(t), master=self.root)
        self.canvas.itemconfigure(self.item, image=self.photo)

    def _compose(self, t):
        from PIL import Image
        import math
        dpi = self.dpi
        img = self.sky.copy()

        p = _ease(_seg(t, *self.PORTRAIT_IN))
        if p > 0 and self.portrait_rgb is not None:
            img.paste(self.portrait_rgb, (self.portrait_at[0] + round((1 - p) * 280 * dpi), self.portrait_at[1]), self.portrait_alpha.point(_lut(p)))

        fade = 1.0 if t < self.RIPPLE_END else max(0.0, 1 - (t - self.RIPPLE_END) / 400.0)
        if fade > 0 and t >= self.RIPPLE_START:
            for cx, cy, r0, delay in self.ripples:
                tt = t - self.RIPPLE_START - delay
                if tt < 0:
                    continue
                ph = (tt % self.RIPPLE_PERIOD) / self.RIPPLE_PERIOD
                a = (ph / .15 if ph < .15 else (1 - ph) / .85) * .85 * fade
                if a > .03:
                    _draw_ripple(img, cx, cy, r0 * (.15 + 1.35 * ph), a)

        c = _ease(_seg(t, *self.CARD_IN))
        if c > 0:
            img = Image.blend(img, self.full, c)

        tin, tout = _ease(_seg(t, *self.TITLE_IN)), _ease(_seg(t, *self.TITLE_OUT))
        a = tin * (1 - tout)
        if a > .01:
            x, y = self.title_pos
            y -= round(70 * dpi * tout)
            pulse = _seg(t, self.voice_at, self.voice_at + 1000)
            if 0 < pulse < 1:
                g = math.sin(math.pi * pulse) * .9 * a
                img.paste(Image.new("RGB", self.title_rgb.size, (214, 242, 255)), (x, y), self.glow_alpha.point(_lut(g)))
            img.paste(self.title_rgb, (x, y), self.title_alpha.point(_lut(a)))

        fx0, fy0, fx1, fy1 = self.frame_rect
        for i, (y0, piece) in enumerate(self.rows):
            q = _ease(_seg(t, self.ROWS_START + i * self.row_step, self.ROWS_START + i * self.row_step + self.ROW_MS))
            if q <= 0:
                continue
            y = y0 + round((1 - q) * 46 * dpi)
            ph = min(piece.height, fy1 - y)
            if ph <= 0:
                continue
            pc = piece if ph == piece.height else piece.crop((0, 0, piece.width, ph))
            img.paste(pc, (fx0, y), Image.new("L", pc.size, int(255 * q)))
        return img


def capture_client(root):
    """Snapshot of the window's client area (Windows PrintWindow), or None if it can't be captured."""
    try:
        import ctypes
        from ctypes import wintypes
        from PIL import Image, ImageStat
        user32, gdi32 = ctypes.windll.user32, ctypes.windll.gdi32
        H = ctypes.c_void_p
        user32.GetAncestor.restype, user32.GetAncestor.argtypes = H, [H, wintypes.UINT]
        user32.GetWindowDC.restype, user32.GetWindowDC.argtypes = H, [H]
        user32.ReleaseDC.argtypes = [H, H]
        user32.PrintWindow.argtypes = [H, H, wintypes.UINT]
        user32.GetWindowRect.argtypes = [H, ctypes.POINTER(wintypes.RECT)]
        user32.ClientToScreen.argtypes = [H, ctypes.POINTER(wintypes.POINT)]
        gdi32.CreateCompatibleDC.restype, gdi32.CreateCompatibleDC.argtypes = H, [H]
        gdi32.CreateCompatibleBitmap.restype, gdi32.CreateCompatibleBitmap.argtypes = H, [H, ctypes.c_int, ctypes.c_int]
        gdi32.SelectObject.restype, gdi32.SelectObject.argtypes = H, [H, H]
        gdi32.DeleteObject.argtypes = [H]
        gdi32.DeleteDC.argtypes = [H]
        gdi32.GetDIBits.argtypes = [H, H, wintypes.UINT, wintypes.UINT, ctypes.c_void_p, ctypes.c_void_p, wintypes.UINT]

        class BITMAPINFOHEADER(ctypes.Structure):
            _fields_ = [("biSize", wintypes.DWORD), ("biWidth", wintypes.LONG), ("biHeight", wintypes.LONG),
                        ("biPlanes", wintypes.WORD), ("biBitCount", wintypes.WORD), ("biCompression", wintypes.DWORD),
                        ("biSizeImage", wintypes.DWORD), ("biXPelsPerMeter", wintypes.LONG),
                        ("biYPelsPerMeter", wintypes.LONG), ("biClrUsed", wintypes.DWORD), ("biClrImportant", wintypes.DWORD)]

        hwnd = user32.GetAncestor(ctypes.c_void_p(root.winfo_id()), 2)
        rect, origin = wintypes.RECT(), wintypes.POINT(0, 0)
        user32.GetWindowRect(hwnd, ctypes.byref(rect))
        user32.ClientToScreen(hwnd, ctypes.byref(origin))
        ww, wh = rect.right - rect.left, rect.bottom - rect.top
        dx, dy = origin.x - rect.left, origin.y - rect.top
        hdc = user32.GetWindowDC(hwnd)
        mem = gdi32.CreateCompatibleDC(hdc)
        bmp = gdi32.CreateCompatibleBitmap(hdc, ww, wh)
        old = gdi32.SelectObject(mem, bmp)
        ok = user32.PrintWindow(hwnd, mem, 2)  # 2 = PW_RENDERFULLCONTENT
        info = BITMAPINFOHEADER(ctypes.sizeof(BITMAPINFOHEADER), ww, -wh, 1, 32, 0, 0, 0, 0, 0, 0)
        buf = ctypes.create_string_buffer(ww * wh * 4)
        gdi32.GetDIBits(mem, bmp, 0, wh, buf, ctypes.byref(info), 0)
        gdi32.SelectObject(mem, old)
        gdi32.DeleteObject(bmp)
        gdi32.DeleteDC(mem)
        user32.ReleaseDC(hwnd, hdc)
        if not ok:
            return None
        shot = Image.frombuffer("RGBA", (ww, wh), buf, "raw", "BGRA", 0, 1).convert("RGB")
        shot = shot.crop((dx, dy, dx + root.winfo_width(), dy + root.winfo_height()))
        if max(ImageStat.Stat(shot).mean) < 20:
            return None
        return shot
    except Exception:
        return None


def build_rows(snapshot, frame):
    """Cut the window snapshot into horizontal bands, one per widget, bottom band first."""
    kids = sorted((frame.grid_slaves() or frame.pack_slaves()), key=lambda c: c.winfo_y())
    fx0, fy0 = frame.winfo_x(), frame.winfo_y()
    fx1, fy1 = fx0 + frame.winfo_width(), fy0 + frame.winfo_height()
    spans = [(fy0 + c.winfo_y(), fy0 + c.winfo_y() + c.winfo_height()) for c in kids]
    bounds = [fy0] + [(spans[i][1] + spans[i + 1][0]) // 2 for i in range(len(spans) - 1)] + [fy1]
    rows = [(bounds[i], snapshot.crop((fx0, bounds[i], fx1, bounds[i + 1]))) for i in range(len(spans))]
    rows.reverse()
    return rows, (fx0, fy0, fx1, fy1)


def main():
    try:
        ctypes.windll.user32.SetProcessDpiAwarenessContext(ctypes.c_void_p(-4))
    except (AttributeError, OSError):
        pass
    root = tk.Tk()
    root.title(f"{APP_NAME} {APP_VERSION} — Local Voice Typing")
    # Scale the window for sharper/high-DPI screens, but never taller than the screen itself.
    dpi = max(1.0, root.winfo_fpixels("1i") / 96.0)
    screen_w, screen_h = root.winfo_screenwidth(), root.winfo_screenheight()
    has_portrait = asset_path(PORTRAIT_FILE).is_file()
    portrait_probe = load_portrait(100) if has_portrait else None
    portrait_ratio = (_portrait_cache["src"].width / _portrait_cache["src"].height
                      if portrait_probe is not None else PORTRAIT_RATIO)
    content_bounds = (portrait_content_bounds(_portrait_cache["src"])
                      if portrait_probe is not None else (0.0, 1.0))
    base_w, min_w = (1500, 1280) if has_portrait else (700, 640)
    root.geometry(f"{min(round(base_w * dpi), screen_w - 40)}x{min(round(860 * dpi), screen_h - 90)}")
    root.minsize(min(round(min_w * dpi), screen_w - 40), min(round(800 * dpi), screen_h - 90))
    if has_portrait:
        try:
            root.attributes("-alpha", 0.0)  # invisible until the intro's first frame is ready
            root.after(12000, lambda: root.attributes("-alpha", 1.0))  # safety net
        except tk.TclError:
            pass
    try:
        import keyboard
        import numpy as np
        import sounddevice as sd
        import pystray
        from PIL import Image
    except ImportError as exc:
        messagebox.showerror("Missing dependency", f"{exc}\nRun: python -m pip install keyboard numpy sounddevice pystray pillow")
        root.destroy()
        return
    apply_aero_theme(root)
    try:
        saved = json.loads(SETTINGS.read_text(encoding="utf-8"))
        if not isinstance(saved, dict):
            saved = {}
    except (OSError, ValueError):
        saved = {}
    model_path = tk.StringVar(value=saved.get("model", ""))
    engine_path = tk.StringVar(value=initial_engine_path(saved.get("engine", "")))
    microphone_selection = saved.get("microphone")
    if not (isinstance(microphone_selection, dict) and
            isinstance(microphone_selection.get("name"), str) and
            isinstance(microphone_selection.get("hostapi"), str) and
            isinstance(microphone_selection.get("occurrence"), int)):
        microphone_selection = None
    startup_sound = tk.BooleanVar(value=saved.get("startup_sound", True) is not False)
    try:
        hotkey_config = parse_recording_hotkey(saved.get("hotkey", HOTKEY), keyboard)
    except (ValueError, TypeError):
        hotkey_config = parse_recording_hotkey(HOTKEY, keyboard)
    hotkey_name = tk.StringVar(value=hotkey_config[0])
    try:
        cancel_config = parse_recording_hotkey(saved.get("cancel_hotkey", CANCEL_HOTKEY), keyboard)
    except (ValueError, TypeError):
        cancel_config = parse_recording_hotkey(CANCEL_HOTKEY, keyboard)
    cancel_name = tk.StringVar(value=cancel_config[0])
    numpad_zero = tk.BooleanVar(value=saved.get("numpad_zero", False) is True)
    binding_capture = HotkeyCapture(keyboard)
    trigger = RecordingTrigger(keyboard, lambda: request_toggle())
    trigger.configure(hotkey_config, numpad_zero.get())
    # Cancel only grabs its key while recording or transcribing; otherwise the key behaves normally.
    cancel_trigger = RecordingTrigger(keyboard, lambda: request_cancel(), gate=lambda: stream is not None or busy)
    cancel_trigger.configure(cancel_config, False)
    cancel_pending, cancel_job = Event(), Event()
    status = tk.StringVar(value="Choose your model file and whisper-cli.exe above.")
    events, pending, closing = Queue(), Event(), Event()
    process_lock = Lock()
    running_process = None
    stream = None
    busy = False
    chunks = []
    tray_ready = Event()
    indicator = MicIndicator()
    badges = {"ready": microphone_image((156, 177, 199)),
              "recording": microphone_image((112, 227, 255)),
              "transcribing": microphone_image((255, 198, 113))}
    root.iconphoto(True, __import__("PIL.ImageTk", fromlist=["PhotoImage"]).PhotoImage(badges["recording"]))

    def tray_run():
        try:
            def setup(icon):
                icon.visible = True
                tray_ready.set()
            tray.run(setup=setup)
        except Exception as exc:
            events.put(("tray_error", str(exc)))

    tray = pystray.Icon("lumascribe", badges["ready"], f"{APP_NAME} — Ready",
        menu=pystray.Menu(
            pystray.MenuItem(f"Open {APP_NAME}", lambda icon, item: events.put(("show", None)), default=True),
            pystray.MenuItem("Quit", lambda icon, item: events.put(("quit", None)))))
    Thread(target=tray_run, daemon=True).start()

    def phase(name):
        tray.icon = badges[name]
        tray.title = f"{APP_NAME} — " + name.capitalize()
        if name == "ready":
            indicator.hide()
        else:
            indicator.show(badges[name])

    def hide_window():
        if tray_ready.is_set():
            root.withdraw()
        else:
            root.iconify()

    def show_window():
        root.deiconify()
        root.lift()

    from PIL import ImageTk
    margin, bottom_gap, inset = round(22 * dpi), round(54 * dpi), round(18 * dpi)
    radius_px = round(22 * dpi)
    render_lock, render_queue = Lock(), Queue()
    state = {"gen": 0, "job": None, "size": None, "photo": None}

    # Wallpaper canvas: sky, grid, portrait and the card, plus the portrait's glowing butterflies.
    backdrop = tk.Canvas(root, borderwidth=0, highlightthickness=0, background="#d3ebfa")
    backdrop.place(x=0, y=0, relwidth=1, relheight=1)
    bg_item = backdrop.create_image(0, 0, anchor="nw")
    fly_items = []
    frame = ttk.Frame(root)
    frame.columnconfigure(0, weight=1)
    frame.rowconfigure(8, weight=1, minsize=round(180 * dpi))

    def place_panel(width, height):
        lay = compute_layout(width, height, dpi, has_portrait, portrait_ratio, content_bounds)
        x0, y0, x1, y1 = lay["box"]
        frame.place(x=x0 + inset, y=y0 + inset, width=x1 - x0 - 2 * inset,
                    height=y1 - y0 - 2 * inset)
        return lay

    def render_backdrop(width, height):
        """The heavy picture work; safe to run away from the main thread."""
        lay = compute_layout(width, height, dpi, has_portrait, portrait_ratio, content_bounds)
        with render_lock:
            portrait = load_portrait(lay["ph"]) if has_portrait else None
            image = aero_backdrop(width, height, margin, bottom_gap, radius_px, CARD_RGB, box=lay["box"],
                                  portrait=portrait, portrait_at=(lay["px"], lay["py"]))
            return lay, image, portrait_glow_sprites(portrait, lay)

    def apply_backdrop(width, height, lay, image, flies):
        state["size"] = (width, height)
        state["photo"] = ImageTk.PhotoImage(image, master=root)
        backdrop.itemconfigure(bg_item, image=state["photo"])
        place_panel(root.winfo_width(), root.winfo_height())
        for item, _ in fly_items:
            backdrop.delete(item)
        fly_items.clear()
        for fx, fy, frames in flies:
            photos = [ImageTk.PhotoImage(f, master=root) for f in frames]
            fly_items.append((backdrop.create_image(fx, fy, anchor="nw", image=photos[0]), photos))

    def launch_render():
        state["job"] = None
        width, height = root.winfo_width(), root.winfo_height()
        if width < 200 or height < 200 or (width, height) == state["size"]:
            return
        state["gen"] += 1
        gen = state["gen"]

        def work():
            try:
                render_queue.put((gen, width, height, render_backdrop(width, height)))
            except Exception:
                pass
        Thread(target=work, daemon=True).start()

    def request_backdrop(event):
        # Resize controls immediately; only the expensive wallpaper render is debounced.
        if event.widget is root:
            place_panel(event.width, event.height)
            if state["job"] is not None:
                root.after_cancel(state["job"])
            state["job"] = root.after(140, launch_render)

    def collect_render():
        try:
            while True:
                gen, width, height, (lay, image, flies) = render_queue.get_nowait()
                if (gen == state["gen"] and not closing.is_set() and
                        (width, height) == (root.winfo_width(), root.winfo_height())):
                    apply_backdrop(width, height, lay, image, flies)
        except Empty:
            pass
        root.after(40, collect_render)
    root.bind("<Configure>", request_backdrop, add="+")
    root.after(40, collect_render)

    banner_h = round(112 * dpi)
    banner = tk.Canvas(frame, height=banner_h, highlightthickness=0, borderwidth=0, background=CARD)
    banner.grid(row=0, column=0, sticky="ew", pady=(0, 8))
    banner_photo = None
    glow_items = []
    banner_job = [None]

    def paint_banner():
        nonlocal banner_photo
        banner_job[0] = None
        width = max(1, banner.winfo_width())
        banner_photo = ImageTk.PhotoImage(aero_banner(width, banner_h, CARD_RGB, round(14 * dpi)), master=root)
        banner.delete("all")
        banner.create_image(0, 0, anchor="nw", image=banner_photo)
        x, y = round(26 * dpi), round(38 * dpi)
        banner.create_text(x + 2, y + 2, anchor="w", text=APP_NAME, fill="#0a5a8c", font=("Segoe UI", 26, "bold"))
        banner.create_text(x, y, anchor="w", text=APP_NAME, fill="#ffffff", font=("Segoe UI", 26, "bold"))
        banner.create_text(x + 1, round(72 * dpi) + 1, anchor="w", text="Speak freely. Stay local.", fill="#0a5a8c", font=("Segoe UI", 11))
        banner.create_text(x, round(72 * dpi), anchor="w", text="Speak freely. Stay local.", fill="#f2fcff", font=("Segoe UI", 11))
        glow_items.clear()
        for gx, gy, frames in banner_glow_sprites(width, banner_h):
            photos = [ImageTk.PhotoImage(f, master=root) for f in frames]
            glow_items.append((banner.create_image(gx, gy, image=photos[0]), photos))

    def schedule_banner(event):
        if banner_job[0] is not None:
            root.after_cancel(banner_job[0])
            banner_job[0] = None
        if banner_photo is None and event.width > 50:
            paint_banner()          # the first picture appears immediately
        else:
            banner_job[0] = root.after(120, paint_banner)
    banner.bind("<Configure>", schedule_banner)

    glow_t0 = [None]

    def pulse_glow():
        # Every butterfly, in the portrait and in the header, breathes in and out of a soft white glow like a firefly.
        if glow_t0[0] is not None and root.state() not in ("withdrawn", "iconic"):
            now = time.perf_counter()
            gain = min(1.0, (now - glow_t0[0]) / 2.0)
            gain = gain * gain * (3 - 2 * gain)          # ease in, so the glow never just switches on
            for i, (item, photos) in enumerate(glow_items):
                level = .5 + .5 * math.sin(now * (1.05 + .15 * i) + i * 1.9)
                banner.itemconfigure(item, image=photos[round(gain * level * (len(photos) - 1))])
            for i, (item, photos) in enumerate(fly_items):
                level = .5 + .5 * math.sin(now * (.85 + .11 * i) + i * 2.3)
                backdrop.itemconfigure(item, image=photos[round(gain * level * (len(photos) - 1))])
        root.after(50, pulse_glow)
    root.after(50, pulse_glow)

    def save_settings():
        try:
            SETTINGS.parent.mkdir(parents=True, exist_ok=True)
            SETTINGS.write_text(json.dumps({"model": model_path.get(), "engine": engine_path.get(),
                                           "startup_sound": startup_sound.get(), "microphone": microphone_selection,
                                           "hotkey": hotkey_name.get(), "cancel_hotkey": cancel_name.get(),
                                           "numpad_zero": numpad_zero.get()}), encoding="utf-8")
        except OSError:
            status.set("Selected files work, but settings could not be saved.")

    def sound_preference():
        if not startup_sound.get():
            opening_sound()
        save_settings()

    preferences = ttk.Frame(frame)
    preferences.grid(row=1, column=0, sticky="ew", pady=(0, 4))
    ttk.Checkbutton(preferences, text="Play opening sound on launch", variable=startup_sound,
                    command=sound_preference).pack(side="left")

    def hotkey_settings():
        if stream is not None or busy:
            return
        trigger.paused = cancel_trigger.paused = True
        pending.clear()
        cancel_pending.clear()
        dialog = tk.Toplevel(root)
        dialog.title("Recording hotkeys")
        dialog.transient(root)
        dialog.resizable(False, False)
        panel = ttk.Frame(dialog, padding=18)
        panel.pack(fill="both", expand=True)
        draft = tk.StringVar(value=hotkey_name.get())
        draft_numpad = tk.BooleanVar(value=numpad_zero.get())
        draft_cancel = tk.StringVar(value=cancel_name.get())
        capture_target = [None]
        capture_job = [None]
        capture_hint = tk.StringVar(value="Click a binding, then press a key or combination.")

        def stop_capture():
            binding_capture.cancel()
            capture_target[0] = None
            choice.config(text=draft.get())
            cancel_choice.config(text=draft_cancel.get())
            apply_button.config(state="normal")

        def capture_keys(variable, widget):
            stop_capture()
            capture_target[0] = variable
            binding_capture.arm()
            widget.config(text="Press a key or combination…")
            capture_hint.set("Hold any modifiers, press the main key, then release it. Escape can also be bound.")
            apply_button.config(state="disabled")

        ttk.Label(panel, text="Recording hotkey").pack(anchor="w")
        choice = ttk.Button(panel, text=draft.get(),
                            command=lambda: capture_keys(draft, choice))
        choice.pack(fill="x", pady=(5, 8))
        ttk.Label(panel, textvariable=capture_hint, wraplength=430,
                  style="Hint.TLabel").pack(anchor="w")
        ttk.Button(panel, text="Stop selecting", command=stop_capture).pack(anchor="w", pady=(6, 0))
        ttk.Checkbutton(panel, text="Also use numpad 0 / Insert as a trigger",
                        variable=draft_numpad).pack(anchor="w", pady=(12, 4))
        ttk.Label(panel, text="Off by default. When enabled, this key is reserved for recording\n"
                  "with Num Lock on or off; it will no longer type 0.",
                  style="Hint.TLabel").pack(anchor="w")
        ttk.Label(panel, text="Cancel hotkey").pack(anchor="w", pady=(14, 0))
        cancel_choice = ttk.Button(panel, text=draft_cancel.get(),
                                   command=lambda: capture_keys(draft_cancel, cancel_choice))
        cancel_choice.pack(fill="x", pady=(5, 6))
        ttk.Label(panel, text="Cancel stops recording/transcription without typing.\n"
                  "Its key behaves normally while the app is idle.", style="Hint.TLabel").pack(anchor="w")

        def receive_capture():
            try:
                while True:
                    kind, value = binding_capture.results.get_nowait()
                    if kind == "captured" and capture_target[0] is not None:
                        capture_target[0].set(value)
                        stop_capture()
                        capture_hint.set("Binding selected. Click Apply to save it.")
                    elif kind == "error":
                        capture_hint.set(value)
            except Empty:
                pass
            capture_job[0] = dialog.after(30, receive_capture)

        def dismiss():
            stop_capture()
            if capture_job[0] is not None:
                dialog.after_cancel(capture_job[0])
            dialog.grab_release()
            dialog.destroy()
            trigger.paused = cancel_trigger.paused = False

        def apply():
            try:
                config = parse_recording_hotkey(draft.get(), keyboard)
            except (ValueError, TypeError) as exc:
                messagebox.showerror("Invalid hotkey", str(exc), parent=dialog)
                return
            try:
                cancel_cfg = parse_recording_hotkey(draft_cancel.get(), keyboard)
            except (ValueError, TypeError) as exc:
                messagebox.showerror("Invalid cancel hotkey", str(exc), parent=dialog)
                return
            if cancel_cfg[1] & config[1] and cancel_cfg[2] == config[2]:
                messagebox.showerror("Invalid cancel hotkey", "The cancel hotkey must be different from the recording hotkey.", parent=dialog)
                return
            trigger.configure(config, draft_numpad.get())
            cancel_trigger.configure(cancel_cfg, False)
            cancel_name.set(cancel_cfg[0])
            hotkey_name.set(config[0])
            numpad_zero.set(draft_numpad.get())
            status.set(f"Hotkey updated — press {hotkey_name.get()} to record.")
            save_settings()
            button.config(text=f"Start recording ({hotkey_name.get()})")
            dismiss()

        actions = ttk.Frame(panel)
        actions.pack(fill="x", pady=(16, 0))
        apply_button = ttk.Button(actions, text="Apply", command=apply)
        apply_button.pack(side="right")
        ttk.Button(actions, text="Cancel", command=dismiss).pack(side="right", padx=8)
        dialog.protocol("WM_DELETE_WINDOW", dismiss)
        dialog.bind("<Escape>", lambda event: None if binding_capture.active else dismiss())
        dialog.bind("<FocusOut>", lambda event: stop_capture() if event.widget is dialog else None)
        dialog.grab_set()
        choice.focus_set()
        receive_capture()

    hotkey_picker = ttk.Button(preferences, text="Hotkey settings…", command=hotkey_settings)
    hotkey_picker.pack(side="right")

    def select_file(variable, is_model):
        selected = filedialog.askopenfilename(
            title="Choose your ggml-large-v3-turbo.bin" if is_model else "Choose CUDA whisper-cli.exe",
            initialdir=str(MODEL_DIR if is_model else ENGINE_DIR),
            filetypes=[("GGML model", "*.bin")] if is_model else [("Whisper CLI", "whisper-cli.exe")],
        )
        if selected:
            variable.set(selected)
            save_settings()
            status.set(f"Files selected. Click your text field and press {hotkey_name.get()}.")

    selectors = [hotkey_picker]
    for grid_row, (label, variable, is_model) in enumerate([( "Model file (.bin)", model_path, True),
                                      ("CUDA engine", engine_path, False)], start=2):
        row = ttk.Frame(frame, style="Panel.TFrame", padding=(12, 6))
        row.grid(row=grid_row, column=0, sticky="ew", pady=3)
        row.columnconfigure(1, weight=1)
        ttk.Label(row, text=label, style="PanelTitle.TLabel").grid(row=0, column=0, sticky="w", padx=(0, 10))
        ttk.Entry(row, textvariable=variable, state="readonly").grid(row=0, column=1, sticky="ew")
        picker = ttk.Button(row, text="Choose file…", command=lambda v=variable, m=is_model: select_file(v, m))
        picker.grid(row=0, column=2, padx=(10, 0))
        selectors.append(picker)
    # Compact microphone row below model/engine, leaving room for history.
    mic_row = ttk.Frame(frame, style="Panel.TFrame", padding=(12, 8))
    mic_row.grid(row=4, column=0, sticky="ew", pady=3)
    mic_row.columnconfigure(1, weight=1)
    ttk.Label(mic_row, text="Microphone", style="PanelTitle.TLabel").grid(row=0, column=0, padx=(0, 10))
    mic_name = tk.StringVar()
    mic_picker = ttk.Combobox(mic_row, textvariable=mic_name, state="readonly", width=24)
    mic_picker.grid(row=0, column=1, sticky="ew")
    mic_choices = []

    def refresh_microphones():
        nonlocal microphone_selection
        if stream is not None or busy:
            return
        try:
            devices = microphone_devices(sd)
        except Exception as exc:
            devices = []
            status.set(f"Could not list microphones: {exc}. Click Refresh to retry.")
        matched = match_microphone(devices, microphone_selection)
        if matched is not None and matched["id"] != microphone_selection:
            microphone_selection = matched["id"]
            save_settings()
        mic_choices[:] = [None] + [item["id"] for item in devices]
        labels = ["System default"] + [item["label"] for item in devices]
        if microphone_selection not in mic_choices:
            mic_choices.append(microphone_selection)
            labels.append(f"Unavailable: {microphone_selection['name']}")
        mic_picker.configure(values=labels)
        mic_picker.current(mic_choices.index(microphone_selection))

    def select_microphone(event=None):
        nonlocal microphone_selection
        if stream is not None or busy:
            return
        index = mic_picker.current()
        if 0 <= index < len(mic_choices):
            microphone_selection = mic_choices[index]
            save_settings()
            status.set(f"Microphone selected: {mic_name.get()}.")

    mic_picker.bind("<<ComboboxSelected>>", select_microphone)
    mic_refresh = ttk.Button(mic_row, text="Refresh", command=refresh_microphones)
    mic_refresh.grid(row=0, column=2, padx=(10, 0))
    selectors.extend((mic_picker, mic_refresh))
    refresh_microphones()
    status_row = tk.Frame(frame, background="#dcf2fb", highlightthickness=1, highlightbackground="#a9d6e9")
    status_row.grid(row=5, column=0, sticky="ew", pady=6)
    tk.Frame(status_row, width=5, background="#3fc5d8").pack(side="left", fill="y")
    status_label = ttk.Label(status_row, textvariable=status, style="Status.TLabel", wraplength=500)
    status_label.pack(side="left", fill="both", expand=True)
    status_label.bind("<Configure>", lambda e: status_label.configure(wraplength=max(160, e.width - 24)))
    button = ttk.Button(frame, text=f"Start recording ({hotkey_name.get()})", style="Record.TButton")
    button.grid(row=6, column=0, sticky="ew")
    ttk.Label(frame, text="Blue microphone: recording · Amber: transcribing\n"
              "Close this window to hide in the tray. Right-click the tray icon to Quit.",
              justify="center", style="Hint.TLabel").grid(row=7, column=0, sticky="ew", pady=(6, 0))
    history_entries = []
    # Bottom row (reserved first so it never gets squeezed out of tight windows).
    footer = ttk.Frame(frame)
    footer.grid(row=9, column=0, sticky="ew", pady=(6, 0))
    history_frame = ttk.Frame(frame, style="Panel.TFrame", padding=(12, 8, 12, 12))
    history_frame.grid(row=8, column=0, sticky="nsew", pady=(8, 5))
    history_frame.columnconfigure(0, weight=1)
    history_frame.rowconfigure(1, weight=1)
    ttk.Label(history_frame, text="Transcription history (this session)", style="PanelTitle.TLabel").grid(
        row=0, column=0, columnspan=2, sticky="w", pady=(0, 6))
    history = tk.Text(history_frame, wrap="word", height=1, state="disabled",
                      font=("Segoe UI", 10), background="#fbfeff", foreground="#26485e",
                      relief="flat", borderwidth=0, highlightthickness=1,
                      highlightbackground="#a3d1e6", highlightcolor="#4fb4de",
                      selectbackground="#bfe6f8", selectforeground="#0f3f5a",
                      padx=10, pady=8, spacing3=2)
    history.grid(row=1, column=0, sticky="nsew")
    scrollbar = ttk.Scrollbar(history_frame, orient="vertical", command=history.yview)
    scrollbar.grid(row=1, column=1, sticky="ns", padx=(6, 0))
    history.config(yscrollcommand=scrollbar.set)
    history.tag_configure("heading", foreground="#26907a", font=("Segoe UI", 9, "bold"))

    def append_history(text):
        history_entries.append(text)
        heading = f"Recording {len(history_entries)} · {datetime.now():%H:%M:%S}"
        history.config(state="normal")
        history.insert("end", heading + "\n", "heading")
        history.insert("end", (text or "No speech detected.") + "\n\n")
        history.config(state="disabled")
        history.see("end")

    def copy_history():
        text = "\n\n".join(entry for entry in history_entries if entry)
        if text:
            root.clipboard_clear()
            root.clipboard_append(text)

    ttk.Button(footer, text="Copy all transcriptions", command=copy_history).pack(side="left")

    def controls(enabled):
        for picker in selectors:
            picker.config(state=("readonly" if picker is mic_picker else "normal") if enabled else "disabled")

    def ready():
        nonlocal busy
        busy = False
        phase("ready")
        button.config(text=f"Start recording ({hotkey_name.get()})", state="normal")
        controls(True)

    def capture(data, frames, time_info, audio_status):
        chunks.append(data.copy())
        if audio_status:
            events.put(("warning", str(audio_status)))

    def transcribe(audio, model, engine):
        nonlocal running_process
        try:
            with tempfile.TemporaryDirectory(prefix="voice_typing_") as tmp:
                wav_path = Path(tmp) / "audio.wav"
                output = Path(tmp) / "transcript"
                with wave.open(str(wav_path), "wb") as wav:
                    wav.setnchannels(1)
                    wav.setsampwidth(2)
                    wav.setframerate(SAMPLE_RATE)
                    wav.writeframes((np.clip(audio, -1, 1) * 32767).astype("<i2").tobytes())
                args = [engine, "-m", model, "-f", str(wav_path), "-l", "en",
                        "-otxt", "-of", str(output), "-nt", "-bs", "1"]
                # Use the engine folder so its GPU DLLs remain discoverable.
                with process_lock:
                    if closing.is_set():
                        return
                    proc = subprocess.Popen(args, cwd=str(Path(engine).parent),
                        stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                        creationflags=subprocess.CREATE_NO_WINDOW)
                    running_process = proc
                while True:
                    try:
                        stdout, stderr = proc.communicate(timeout=0.2)
                        break
                    except subprocess.TimeoutExpired:
                        if closing.is_set() or cancel_job.is_set():
                            proc.kill()
                            proc.communicate()
                            if cancel_job.is_set() and not closing.is_set():
                                events.put(("cancelled", None))
                            return
                if cancel_job.is_set():
                    events.put(("cancelled", None))
                    return
                log = (stderr + stdout).decode("utf-8", errors="replace")
                if proc.returncode:
                    raise RuntimeError(f"Engine exited with code {proc.returncode}.\n" + log[-5000:])
                # Do not silently accept a CPU-only build or GPU fallback.
                if not re.search(r"(?:using\s+CUDA\d*\s+backend|CUDA\d+\s+(?:total size|buffer size)|CUDA\d+.*compute buffer)", log, re.I):
                    raise RuntimeError("CUDA model execution was not confirmed. Choose a CUDA-enabled "
                        "whisper-cli.exe and keep its DLLs alongside it.\n\n" + log[-5000:])
                text = " ".join(output.with_suffix(".txt").read_text(encoding="utf-8-sig").split()).strip()
                if closing.wait(0.2):
                    return
                if cancel_job.is_set():
                    events.put(("cancelled", None))
                    return
                if text:
                    keyboard.write(text + " ", exact=True)
                events.put(("done", text))
        except Exception as exc:
            events.put(("error", str(exc)))
        finally:
            with process_lock:
                running_process = None

    def toggle():
        nonlocal stream, busy
        if busy:
            return
        try:
            if stream is None:
                model, engine = model_path.get(), engine_path.get()
                if not model or not Path(model).is_file():
                    messagebox.showinfo("Select model", "Click Choose file next to Model and select your ggml-large-v3-turbo.bin.")
                    return
                if not engine or not Path(engine).is_file():
                    messagebox.showinfo("Select engine", "Click Choose file next to CUDA engine and select whisper-cli.exe.\nWhisperDesktop.exe is a different program and cannot be used here.")
                    return
                if Path(engine).name.lower() != "whisper-cli.exe":
                    raise ValueError("Select whisper-cli.exe, not WhisperDesktop.exe.")
                opening_sound()
                chunks.clear()
                controls(False)
                stream = microphone_stream(sd, microphone_selection, capture)
                stream.start()
                phase("recording")
                status.set(f"Recording — press {hotkey_name.get()} to stop, {cancel_name.get()} to cancel.")
                button.config(text=f"Stop and type ({hotkey_name.get()})")
            else:
                stream.stop()
                stream.close()
                stream = None
                if not chunks:
                    ready()
                    status.set("No audio recorded.")
                    return
                audio = np.concatenate(chunks).reshape(-1)
                chunks.clear()
                busy = True
                cancel_job.clear()
                phase("transcribing")
                status.set(f"Loading your model and transcribing on the local engine… ({cancel_name.get()} to cancel)")
                button.config(text="Transcribing…", state="disabled")
                user32 = ctypes.windll.user32
                user32.GetAncestor.restype = ctypes.c_void_p
                user32.GetForegroundWindow.restype = ctypes.c_void_p
                hwnd = user32.GetAncestor(ctypes.c_void_p(root.winfo_id()), 2)
                if user32.GetForegroundWindow() == hwnd:
                    hide_window()
                Thread(target=transcribe, args=(audio, model_path.get(), engine_path.get()), daemon=True).start()
        except Exception as exc:
            if stream is not None:
                stream.close()
                stream = None
            chunks.clear()
            ready()
            status.set("Recording failed.")
            messagebox.showerror("Recording error", str(exc))

    def poll():
        if pending.is_set():
            pending.clear()
            if not trigger.paused:
                toggle()
        if cancel_pending.is_set():
            cancel_pending.clear()
            if not cancel_trigger.paused:
                do_cancel()
        try:
            while True:
                kind, value = events.get_nowait()
                if kind == "cancelled":
                    ready()
                    status.set("Cancelled — nothing was typed.")
                elif kind == "show":
                    show_window()
                elif kind == "quit":
                    close()
                    return
                elif kind == "tray_error":
                    show_window()
                    messagebox.showerror("Tray icon failed", value + "\nThe window will remain accessible via the taskbar.")
                elif kind in ("update_checked", "update_downloaded", "update_error"):
                    if stream is not None or busy:
                        events.put((kind, value))
                        break
                    update_in_progress[0] = False
                    update_button.config(state="normal")
                    if kind == "update_checked":
                        offer_update(value)
                    elif kind == "update_downloaded":
                        status.set("Update downloaded.")
                        messagebox.showinfo("Update downloaded", f"Saved to:\n{value}\n\nQuit LumaScribe, extract the ZIP to a new folder, and open its launcher. Your settings will carry over.", parent=root)
                    else:
                        status.set("Update check/download failed; voice typing is still available.")
                        messagebox.showinfo("LumaScribe updates", value, parent=root)
                elif kind == "done":
                    ready()
                    append_history(value)
                    status.set("Ready — local model, CUDA confirmed.")
                elif kind == "error":
                    ready()
                    status.set("Transcription failed — see error details.")
                    root.deiconify()
                    messagebox.showerror("Transcription error", value)
                elif kind == "warning" and stream is not None:
                    status.set(f"Recording — microphone: {value}")
        except Empty:
            pass
        indicator.follow()
        root.after(50, poll)

    def request_cancel():
        if not cancel_trigger.paused and not closing.is_set():
            cancel_pending.set()

    def do_cancel():
        nonlocal stream
        if stream is not None:
            try:
                stream.abort()
                stream.close()
            finally:
                stream = None
            chunks.clear()
            ready()
            status.set("Recording cancelled — nothing was typed.")
        elif busy:
            cancel_job.set()
            status.set("Cancelling…")

    def request_toggle():
        if not trigger.paused and not busy and not closing.is_set():
            pending.set()

    def close():
        closing.set()
        binding_capture.cancel()
        opening_sound()
        with process_lock:
            if running_process is not None and running_process.poll() is None:
                running_process.kill()
        keyboard.unhook(hook)
        keyboard.unhook(cancel_hook)
        if stream is not None:
            stream.abort()
            stream.close()
        indicator.close()
        tray.stop()
        root.destroy()

    ttk.Button(footer, text="Quit completely", command=close).pack(side="right")
    update_in_progress = [False]

    def check_updates():
        if stream is not None or busy or update_in_progress[0]:
            return
        update_in_progress[0] = True
        update_button.config(state="disabled")
        status.set("Checking GitHub for updates…")

        def work():
            try:
                events.put(("update_checked", check_latest_release()))
            except Exception as exc:
                events.put(("update_error", str(exc)))
        Thread(target=work, daemon=True).start()

    def offer_update(release):
        if release is None:
            status.set(f"LumaScribe {APP_VERSION} is up to date.")
            return
        if not messagebox.askyesno("LumaScribe update", f"LumaScribe {release['version']} is available.\nDownload it now?", parent=root):
            return
        destination = filedialog.asksaveasfilename(parent=root, title="Save LumaScribe update",
                       initialfile=release["asset"]["name"], defaultextension=".zip", filetypes=[("ZIP archive", "*.zip")])
        if not destination:
            return
        update_in_progress[0] = True
        update_button.config(state="disabled")
        status.set("Downloading LumaScribe update…")

        def work():
            try:
                download_release(release["asset"], destination, closing)
                events.put(("update_downloaded", destination))
            except Exception as exc:
                events.put(("update_error", str(exc)))
        Thread(target=work, daemon=True).start()

    update_button = ttk.Button(footer, text="Check for updates", command=check_updates)
    update_button.pack(side="right", padx=8)
    selectors.append(update_button)

    # Honor the controls' measured size plus the history's reserved space.
    # A too-small initial window must not squeeze history into a few lines.
    root.update_idletasks()
    required_height = frame.winfo_reqheight() + margin + bottom_gap + 2 * inset
    minimum_height = min(screen_h - 90, max(round(800 * dpi), required_height))
    root.minsize(min(round(min_w * dpi), screen_w - 40), minimum_height)
    if root.winfo_height() < minimum_height:
        root.geometry(f"{root.winfo_width()}x{minimum_height}")

    button.config(command=toggle)
    def recording_hook(event):
        captured = binding_capture.handle(event)
        return trigger.handle(event) if captured is None else captured

    hook = keyboard.hook(recording_hook, suppress=True)
    cancel_hook = keyboard.hook(cancel_trigger.handle, suppress=True)
    root.protocol("WM_DELETE_WINDOW", hide_window)
    def on_minimize(event):
        if event.widget is root and root.state() == "iconic" and tray_ready.is_set():
            root.after_idle(root.withdraw)
    root.bind("<Unmap>", on_minimize)
    root.after(50, poll)

    attempts = [0]

    def start_intro():
        def restore():
            try:
                root.attributes("-alpha", 1.0)
            except tk.TclError:
                pass

        def plain_opening():
            glow_t0[0] = time.perf_counter()
            restore()
            opening_sound(startup_sound.get())

        if not has_portrait:
            plain_opening()
            return
        try:
            root.update()
            width, height = root.winfo_width(), root.winfo_height()
            if width < 300 or height < 300:
                attempts[0] += 1
                if attempts[0] < 60:      # the window isn't on screen yet; try again shortly
                    root.after(50, start_intro)
                else:
                    plain_opening()
                return
            lay = compute_layout(width, height, dpi, has_portrait, portrait_ratio, content_bounds)
            portrait = load_portrait(lay["ph"])
            at = (lay["px"], lay["py"])
            sky = aero_backdrop(width, height, margin, bottom_gap, radius_px, CARD_RGB, box=lay["box"], card=False)
            full = aero_backdrop(width, height, margin, bottom_gap, radius_px, CARD_RGB, box=lay["box"],
                                 portrait=portrait, portrait_at=at)
            # Use the same picture as the window's wallpaper so the intro hands over seamlessly.
            apply_backdrop(width, height, lay, full, portrait_glow_sprites(portrait, lay))
            root.update()
            if banner_job[0] is not None:
                root.after_cancel(banner_job[0])
            paint_banner()          # make sure the header is drawn before the intro takes its snapshot
            root.update()
            rows, rect = [], (0, 0, 0, 0)
            snap = capture_client(root)
            if snap is not None and snap.size == full.size:
                # Reject a bad capture: it must look broadly like what we expect to see.
                from PIL import ImageChops, ImageStat
                diff = ImageChops.difference(snap.resize((64, 64)), full.resize((64, 64)))
                if max(ImageStat.Stat(diff).mean) < 45:
                    rows, rect = build_rows(snap, frame)
            trigger.paused = cancel_trigger.paused = True

            def intro_done():
                trigger.paused = cancel_trigger.paused = False
                glow_t0[0] = time.perf_counter()

            tune_ms = wav_length_ms(TUNE_WAV, 2435)
            IntroPlayer(root, dpi, sky, portrait, full, rows, rect, startup_sound.get(), tune_ms, intro_done, portrait_at=at).start()
        except Exception:
            trigger.paused = cancel_trigger.paused = False
            plain_opening()

    root.after(60, start_intro)
    root.mainloop()


if __name__ == "__main__":
    try:
        main()
    except Exception:
        import traceback
        messagebox.showerror(f"{APP_NAME} could not start", traceback.format_exc())
