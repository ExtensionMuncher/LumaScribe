def _mix(a, b, t):
    """Blend two colors: t=0 gives a, t=1 gives b."""
    return tuple(round(x + (y - x) * t) for x, y in zip(a, b))


def microphone_image(color, size=48):
    """Draw a glossy glass orb with a microphone, a soft colored glow and a drop shadow."""
    from PIL import Image, ImageChops, ImageDraw, ImageFilter
    s = 4
    n = 64 * s

    def B(*v):
        return tuple(round(c * s) for c in v)

    image = Image.new("RGBA", (n, n))
    shadow = Image.new("RGBA", image.size)
    ImageDraw.Draw(shadow).ellipse(B(12, 14, 52, 56), fill=(0, 40, 70, 95))
    image.alpha_composite(shadow.filter(ImageFilter.GaussianBlur(3 * s)))
    halo = Image.new("RGBA", image.size)
    ImageDraw.Draw(halo).ellipse(B(8, 6, 56, 54), fill=(*color, 115))
    image.alpha_composite(halo.filter(ImageFilter.GaussianBlur(5 * s)))

    cx, cy, r = 32, 30, 21
    mask = Image.new("L", image.size)
    ImageDraw.Draw(mask).ellipse(B(cx - r, cy - r, cx + r, cy + r), fill=255)
    body = Image.new("RGBA", image.size)
    bd = ImageDraw.Draw(body)
    top, bottom = _mix(color, (255, 255, 255), .30), tuple(round(c * .64) for c in color)
    y0, y1 = round((cy - r) * s), round((cy + r) * s)
    for y in range(y0, y1 + 1):
        bd.line((0, y, n, y), fill=_mix(top, bottom, (y - y0) / (y1 - y0)) + (255,))
    body.putalpha(mask)
    image.alpha_composite(body)

    # Light bouncing up from the bottom edge of the orb.
    glow = Image.new("RGBA", image.size)
    ImageDraw.Draw(glow).ellipse(B(cx - r * .7, cy + r * .35, cx + r * .7, cy + r * 1.25),
                                 fill=(*_mix(color, (255, 255, 255), .6), 170))
    glow = glow.filter(ImageFilter.GaussianBlur(3 * s))
    glow.putalpha(ImageChops.multiply(glow.getchannel("A"), mask))
    image.alpha_composite(glow)

    # Glossy highlight across the top half, fading downward.
    fade = Image.new("L", image.size)
    fd = ImageDraw.Draw(fade)
    gy0, gy1 = round((cy - r * .93) * s), round((cy - r * .02) * s)
    for y in range(gy0, gy1 + 1):
        fd.line((0, y, n, y), fill=round(200 * (1 - (y - gy0) / (gy1 - gy0)) ** 1.2))
    shape = Image.new("L", image.size)
    ImageDraw.Draw(shape).ellipse(B(cx - r * .8, cy - r * .93, cx + r * .8, cy - r * .02), fill=255)
    gloss = Image.new("RGBA", image.size, (255, 255, 255, 0))
    gloss.putalpha(ImageChops.multiply(ImageChops.multiply(fade, shape), mask))
    image.alpha_composite(gloss)

    draw = ImageDraw.Draw(image)
    draw.ellipse(B(cx - r, cy - r, cx + r, cy + r),
                 outline=tuple(round(c * .45) for c in color) + (235,), width=round(s * 1.2))
    draw.ellipse(B(cx - r + .9, cy - r + .9, cx + r - .9, cy + r - .9),
                 outline=(255, 255, 255, 170), width=max(1, round(s * .8)))

    def mic(dy, fill):
        d = ImageDraw.Draw(image)
        d.rounded_rectangle(B(28.5, 21 + dy, 35.5, 32.5 + dy), radius=3.5 * s, fill=fill)
        d.arc(B(25, 26 + dy, 39, 37 + dy), 0, 180, fill=fill, width=round(1.8 * s))
        d.line(B(32, 37 + dy, 32, 40.5 + dy), fill=fill, width=round(1.8 * s))
        d.line(B(27.5, 40.5 + dy, 36.5, 40.5 + dy), fill=fill, width=round(1.8 * s))

    mic(1, tuple(round(c * .35) for c in color) + (150,))
    mic(0, (255, 255, 255, 255))
    return image.resize((size, size), Image.Resampling.LANCZOS)


class MicIndicator:
    """Alpha-blended, click-through Win32 overlay that never takes focus."""
    def __init__(self):
        from ctypes import wintypes as w
        self.w = w
        self.u = ctypes.WinDLL("user32", use_last_error=True)
        self.g = ctypes.WinDLL("gdi32", use_last_error=True)
        class GUI(ctypes.Structure):
            _fields_ = [("cbSize", w.DWORD), ("flags", w.DWORD)] + [
                (name, w.HWND) for name in ("hwndActive", "hwndFocus", "hwndCapture", "hwndMenuOwner", "hwndMoveSize", "hwndCaret")
            ] + [("rcCaret", w.RECT)]
        class Header(ctypes.Structure):
            _fields_ = [("size", w.DWORD), ("width", w.LONG), ("height", w.LONG),
                        ("planes", w.WORD), ("bits", w.WORD), ("compression", w.DWORD),
                        ("image_size", w.DWORD), ("xppm", w.LONG), ("yppm", w.LONG),
                        ("used", w.DWORD), ("important", w.DWORD)]
        class BitmapInfo(ctypes.Structure):
            _fields_ = [("header", Header), ("colors", w.DWORD * 3)]
        class Blend(ctypes.Structure):
            _fields_ = [("op", w.BYTE), ("flags", w.BYTE), ("alpha", w.BYTE), ("format", w.BYTE)]
        self.GUI, self.BitmapInfo, self.Blend = GUI, BitmapInfo, Blend
        self.u.CreateWindowExW.argtypes = [w.DWORD, w.LPCWSTR, w.LPCWSTR, w.DWORD,
                                          ctypes.c_int, ctypes.c_int, ctypes.c_int, ctypes.c_int,
                                          w.HWND, w.HMENU, w.HINSTANCE, w.LPVOID]
        self.u.CreateWindowExW.restype = w.HWND
        self.u.GetDC.argtypes = [w.HWND]
        self.u.GetDC.restype = w.HDC
        self.u.ReleaseDC.argtypes = [w.HWND, w.HDC]
        self.u.DestroyWindow.argtypes = [w.HWND]
        self.u.ShowWindow.argtypes = [w.HWND, ctypes.c_int]
        self.u.GetGUIThreadInfo.argtypes = [w.DWORD, ctypes.POINTER(GUI)]
        self.u.ClientToScreen.argtypes = [w.HWND, ctypes.POINTER(w.POINT)]
        self.u.UpdateLayeredWindow.argtypes = [w.HWND, w.HDC, ctypes.POINTER(w.POINT),
            ctypes.POINTER(w.SIZE), w.HDC, ctypes.POINTER(w.POINT), w.DWORD, ctypes.POINTER(Blend), w.DWORD]
        self.u.SetWindowPos.argtypes = [w.HWND, w.HWND, ctypes.c_int, ctypes.c_int, ctypes.c_int, ctypes.c_int, w.UINT]
        self.g.CreateCompatibleDC.argtypes = [w.HDC]
        self.g.CreateCompatibleDC.restype = w.HDC
        self.g.CreateDIBSection.argtypes = [w.HDC, ctypes.POINTER(BitmapInfo), w.UINT,
                                          ctypes.POINTER(ctypes.c_void_p), w.HANDLE, w.DWORD]
        self.g.CreateDIBSection.restype = w.HBITMAP
        self.g.SelectObject.argtypes = [w.HDC, w.HANDLE]
        self.g.SelectObject.restype = w.HANDLE
        self.g.DeleteObject.argtypes = [w.HANDLE]
        self.g.DeleteDC.argtypes = [w.HDC]
        # LAYERED | TRANSPARENT | TOOLWINDOW | NOACTIVATE
        self.hwnd = self.u.CreateWindowExW(0x080800A0, "STATIC", "Voice Typing indicator",
                                          0x80000000, 0, 0, 48, 48, None, None, None, None)
        if not self.hwnd:
            raise ctypes.WinError(ctypes.get_last_error())
        self.active = False

    def position(self):
        w = self.w
        info = self.GUI()
        info.cbSize = ctypes.sizeof(info)
        point = w.POINT()
        if self.u.GetGUIThreadInfo(0, ctypes.byref(info)) and info.hwndCaret:
            point.x, point.y = info.rcCaret.right, info.rcCaret.top
            if self.u.ClientToScreen(info.hwndCaret, ctypes.byref(point)):
                point.x += 8
                point.y -= 38
                return self.clamp(point)
        self.u.GetCursorPos(ctypes.byref(point))
        point.x += 14
        point.y -= 48
        return self.clamp(point)

    def clamp(self, point):
        # Clamp to the work area of the nearest monitor, including negative coordinates.
        w = self.w
        class Monitor(ctypes.Structure):
            _fields_ = [("size", w.DWORD), ("monitor", w.RECT), ("work", w.RECT), ("flags", w.DWORD)]
        self.u.MonitorFromPoint.argtypes = [w.POINT, w.DWORD]
        self.u.MonitorFromPoint.restype = w.HANDLE
        self.u.GetMonitorInfoW.argtypes = [w.HANDLE, ctypes.POINTER(Monitor)]
        monitor = Monitor()
        monitor.size = ctypes.sizeof(monitor)
        handle = self.u.MonitorFromPoint(point, 2)
        if self.u.GetMonitorInfoW(handle, ctypes.byref(monitor)):
            point.x = max(monitor.work.left, min(point.x, monitor.work.right - 48))
            point.y = max(monitor.work.top, min(point.y, monitor.work.bottom - 48))
        return point

    def show(self, image):
        w = self.w
        # Windows layered bitmaps require premultiplied BGRA pixels.
        pixels = bytearray()
        for red, green, blue, alpha in image.getdata():
            pixels.extend((blue*alpha//255, green*alpha//255, red*alpha//255, alpha))
        screen = self.u.GetDC(None)
        dc = self.g.CreateCompatibleDC(screen)
        bitmap = old = None
        try:
            info = self.BitmapInfo()
            info.header.size = ctypes.sizeof(info.header)
            info.header.width, info.header.height = 48, -48
            info.header.planes, info.header.bits = 1, 32
            bits = ctypes.c_void_p()
            bitmap = self.g.CreateDIBSection(screen, ctypes.byref(info), 0, ctypes.byref(bits), None, 0)
            if not bitmap:
                raise ctypes.WinError(ctypes.get_last_error())
            ctypes.memmove(bits, bytes(pixels), len(pixels))
            old = self.g.SelectObject(dc, bitmap)
            dest, origin, size = self.position(), w.POINT(0, 0), w.SIZE(48, 48)
            blend = self.Blend(0, 0, 255, 1)
            if not self.u.UpdateLayeredWindow(self.hwnd, screen, ctypes.byref(dest), ctypes.byref(size),
                    dc, ctypes.byref(origin), 0, ctypes.byref(blend), 2):
                raise ctypes.WinError(ctypes.get_last_error())
            self.u.SetWindowPos(self.hwnd, w.HWND(-1), dest.x, dest.y, 48, 48, 0x10)
            self.u.ShowWindow(self.hwnd, 4)  # SW_SHOWNOACTIVATE
            self.active = True
        finally:
            if old:
                self.g.SelectObject(dc, old)
            if bitmap:
                self.g.DeleteObject(bitmap)
            self.g.DeleteDC(dc)
            self.u.ReleaseDC(None, screen)

    def follow(self):
        if self.active:
            point = self.position()
            self.u.SetWindowPos(self.hwnd, self.w.HWND(-1), point.x, point.y, 48, 48, 0x15)

    def hide(self):
        self.active = False
        self.u.ShowWindow(self.hwnd, 0)

    def close(self):
        self.u.DestroyWindow(self.hwnd)


def _bezier(p0, p1, p2, p3, n=56):
    pts = []
    for i in range(n + 1):
        t = i / n
        a, b, c, d = (1 - t) ** 3, 3 * (1 - t) ** 2 * t, 3 * (1 - t) * t ** 2, t ** 3
        pts.append((a * p0[0] + b * p1[0] + c * p2[0] + d * p3[0], a * p0[1] + b * p1[1] + c * p2[1] + d * p3[1]))
    return pts


def _ribbon(draw, ctrl, width, fill):
    """A feathery swoosh: a curve whose thickness swells in the middle and tapers to points."""
    import math
    pts = _bezier(*ctrl)
    left, right = [], []
    for i, (x, y) in enumerate(pts):
        a, b = pts[max(0, i - 1)], pts[min(len(pts) - 1, i + 1)]
        dx, dy = b[0] - a[0], b[1] - a[1]
        n = math.hypot(dx, dy) or 1.0
        nx, ny = -dy / n, dx / n
        w = width * math.sin(math.pi * i / (len(pts) - 1)) ** .8 / 2
        left.append((x + nx * w, y + ny * w))
        right.append((x - nx * w, y - ny * w))
    draw.polygon(left + right[::-1], fill=fill)


def _star(draw, x, y, r, fill):
    """Four-point sparkle."""
    pts = [(0, -1), (.16, -.16), (1, 0), (.16, .16), (0, 1), (-.16, .16), (-1, 0), (-.16, -.16)]
    draw.polygon([(x + px * r, y + py * r) for px, py in pts], fill=fill)


def aero_backdrop(width, height, margin, bottom, radius, card_rgb, left=None, portrait=None, card=True, box=None, portrait_at=(0, 0)):
    """Pale sky, light rays, bubbles and the portrait, with a rounded glass card floating on top."""
    from PIL import Image, ImageChops, ImageDraw, ImageFilter
    import math
    import numpy as np
    w, h = max(2, int(width)), max(2, int(height))
    u = max(1.0, margin / 22.0)

    # Sky gradient with a bright sun glow in the top-right corner.
    ys = np.linspace(0, 1, h)
    stops = [0.0, 0.42, 0.78, 1.0]
    tones = [(74, 170, 238), (140, 212, 246), (206, 238, 252), (244, 252, 255)]
    sky = np.stack([np.interp(ys, stops, [c[i] for c in tones]) for i in range(3)], axis=-1)
    sky = np.repeat(sky[:, None, :], w, axis=1)
    yy, xx = np.mgrid[0:h, 0:w]
    glow = np.exp(-(np.hypot(xx - w * .86, yy - h * .02) / (w * .55)) ** 2)[..., None] * .55
    sky = sky + (255 - sky) * glow
    image = Image.fromarray(np.clip(sky, 0, 255).astype("uint8"), "RGB").convert("RGBA")

    # Soft light rays fanning out from the sun.
    rays = Image.new("RGBA", (w, h), (255, 255, 255, 0))   # white, so blurring never darkens the edges to grey
    rd = ImageDraw.Draw(rays)
    sx, sy, reach = w * .86, -h * .05, h * 1.6
    for angle, spread, alpha in [(92, 4, 22), (105, 7, 34), (118, 5, 26), (132, 9, 30), (150, 6, 22)]:
        a0, a1 = math.radians(angle - spread), math.radians(angle + spread)
        rd.polygon([(sx, sy), (sx + math.cos(a0) * reach, sy + math.sin(a0) * reach),
                    (sx + math.cos(a1) * reach, sy + math.sin(a1) * reach)], fill=(255, 255, 255, alpha))
    image.alpha_composite(rays.filter(ImageFilter.GaussianBlur(6)))

    # Soft white-blue mist along the bottom edge (no green).
    hill_h = round(bottom + 30 * u)
    s = 3
    hills = Image.new("RGBA", (w * s, hill_h * s))

    def ridge(base, amp, freq, phase, top_rgb, bottom_rgb, line=None):
        pts = [(x * s, (hill_h - (base + amp * math.sin(x / w * math.pi * 2 * freq + phase)) * u) * s)
               for x in range(0, w + 4, 3)]
        shape = Image.new("L", hills.size)
        ImageDraw.Draw(shape).polygon(pts + [(hills.size[0], hills.size[1]), (0, hills.size[1])], fill=255)
        layer = Image.new("RGBA", hills.size)
        ld = ImageDraw.Draw(layer)
        top_y = round(min(p[1] for p in pts))
        for y in range(top_y, hills.size[1]):
            ld.line((0, y, hills.size[0], y),
                    fill=_mix(top_rgb, bottom_rgb, (y - top_y) / max(1, hills.size[1] - top_y)) + (150,))
        layer.putalpha(ImageChops.multiply(shape, layer.getchannel("A")))
        hills.alpha_composite(layer)
        if line:
            ImageDraw.Draw(hills).line(pts, fill=line, width=max(2, round(s * 1.4)), joint="curve")

    ridge(31, 7, 1.3, 0.6, (222, 242, 253), (196, 230, 248), (255, 255, 255, 110))
    ridge(16, 6, 1.9, 2.4, (240, 249, 254), (224, 241, 252), (255, 255, 255, 170))
    hills = hills.resize((w, hill_h), Image.Resampling.LANCZOS)
    image.paste(hills, (0, h - hill_h), hills)

    # Cybercore details: faint grid, perspective floor, HUD reticles and scattered markers.
    import random
    S = 2
    hud = Image.new("RGBA", (w * S, h * S))
    hd = ImageDraw.Draw(hud)
    step = max(8, round(44 * u * S))
    for x in range(0, w * S, step):
        hd.line((x, 0, x, h * S), fill=(255, 255, 255, 52), width=S)
    for y in range(0, h * S, step):
        hd.line((0, y, w * S, y), fill=(255, 255, 255, 52), width=S)
    horizon, vx = h * S * .76, w * S * .60
    for i in range(-16, 17):
        hd.line((vx + i * w * S * .010, horizon, vx + i * w * S * .11, h * S), fill=(64, 184, 238, 80), width=S)
    y, gap = horizon, 4 * u * S
    while y < h * S:
        hd.line((0, y, w * S, y), fill=(64, 184, 238, int(30 + 70 * (y - horizon) / max(1, h * S - horizon))), width=S)
        y += gap
        gap *= 1.30
    image.alpha_composite(hud.resize((w, h), Image.Resampling.LANCZOS))

    # The character portrait sits on the left, behind the card.
    if portrait is not None:
        image.paste(portrait, portrait_at, portrait)
    if not card:
        return image.convert("RGB")

    # The frosted glass card itself: soft shadow, white halo, solid face, thin blue edge.
    x0, y0, x1, y1 = box if box else ((margin if left is None else left), margin, w - margin, h - bottom)
    shadow = Image.new("RGBA", (w, h))
    ImageDraw.Draw(shadow).rounded_rectangle((x0 + 2, y0 + 8, x1 - 2, y1 + 8), radius=radius, fill=(6, 60, 100, 120))
    image.alpha_composite(shadow.filter(ImageFilter.GaussianBlur(10)))
    s, pad = 3, 4
    cw, ch = x1 - x0, y1 - y0
    size = ((cw + pad * 2) * s, (ch + pad * 2) * s)

    def rounded(grow):
        m = Image.new("L", size)
        ImageDraw.Draw(m).rounded_rectangle(
            tuple(round(v * s) for v in (pad - grow, pad - grow, pad + cw + grow, pad + ch + grow)),
            radius=round((radius + grow) * s), fill=255)
        return m

    def tint(mask, rgba):
        layer = Image.new("RGBA", size, rgba[:3] + (0,))
        layer.putalpha(mask.point(lambda v: v * rgba[3] // 255))
        return layer

    card = Image.new("RGBA", size)
    card.alpha_composite(tint(rounded(2), (255, 255, 255, 150)))
    card.alpha_composite(tint(rounded(0), tuple(card_rgb) + (255,)))
    card.alpha_composite(tint(ImageChops.subtract(rounded(0), rounded(-1.2)), (120, 190, 222, 255)))
    card = card.resize((cw + pad * 2, ch + pad * 2), Image.Resampling.LANCZOS)
    image.alpha_composite(card, (x0 - pad, y0 - pad))

    # Cyan HUD corner brackets and a tick strip along the card's top edge.
    br = ImageDraw.Draw(image)
    arm, off, lw = round(26 * u), round(7 * u), max(2, round(1.6 * u))
    for cx_, cy_, sx_, sy_ in ((x0 - off, y0 - off, 1, 1), (x1 + off, y0 - off, -1, 1),
                               (x0 - off, y1 + off, 1, -1), (x1 + off, y1 + off, -1, -1)):
        br.line((cx_, cy_, cx_ + sx_ * arm, cy_), fill=(40, 176, 240, 255), width=lw)
        br.line((cx_, cy_, cx_, cy_ + sy_ * arm), fill=(40, 176, 240, 255), width=lw)
        br.rectangle((cx_ - lw, cy_ - lw, cx_ + lw, cy_ + lw), fill=(255, 255, 255, 255))
    for i in range(14):
        tx = x0 + round(60 * u) + i * round(7 * u)
        br.line((tx, y0 - off, tx, y0 - off + (round(6 * u) if i % 4 == 0 else round(3 * u))), fill=(40, 176, 240, 200), width=max(1, lw // 2))
    return image.convert("RGB")


def banner_butterflies(W):
    """Where the header's butterflies sit, in 112-pixel-tall units: (x, y, size, angle, flap)."""
    return ((W - 70, 52, 56, -10, 0, False), (W - 146, 80, 36, 14, 1, True), (W - 196, 34, 38, -16, 1, False),
            (W - 28, 82, 32, 20, 0, True), (max(W * .56, 330), 30, 32, 8, 0, False),
            (max(W * .65, 395), 86, 30, -14, 1, True), (W - 126, 30, 26, 24, 0, True))


def banner_glow_sprites(width, height, levels=20):
    """Soft cyan halos for each butterfly at several brightnesses, so they can pulse like fireflies."""
    from PIL import Image
    import numpy as np
    w, h = max(2, int(width)), max(2, int(height))
    u = h / 112.0
    sprites = []
    for bx, by, size, *_ in banner_butterflies(w / u):
        side = max(16, round(size * 2.6 * u))
        yy, xx = np.mgrid[0:side, 0:side]
        dist = np.hypot(xx - side / 2, yy - side / 2) / (side / 2)
        alpha = np.clip(1 - dist, 0, 1) ** 1.8
        frames = []
        for i in range(levels):
            level = .75 * i / (levels - 1)
            arr = np.zeros((side, side, 4), dtype="uint8")
            arr[..., 0], arr[..., 1], arr[..., 2] = 255, 255, 255
            arr[..., 3] = (alpha * level * 255).astype("uint8")
            frames.append(Image.fromarray(arr, "RGBA"))
        sprites.append((round(bx * u), round(by * u), frames))
    return sprites


def aero_banner(width, height, bg_rgb, radius):
    """Header picture: glowing blue gradient, faint circuit traces, a halo and glowing butterflies."""
    from PIL import Image, ImageChops, ImageDraw, ImageFilter
    import math
    import random
    import numpy as np
    w, h = max(2, int(width)), max(2, int(height))
    u = h / 112.0          # everything below is drawn in "112-pixel-tall" units
    W = w / u
    s = 3
    k = s * u

    def B(*v):
        return tuple(round(c * k) for c in v)

    xs = np.linspace(0, 1, w)[None, :, None]
    ys = np.linspace(0, 1, h)[:, None, None]
    c0, c1 = np.array((46, 150, 222.0)), np.array((150, 230, 250.0))
    grad = (c0 + (c1 - c0) * xs ** 1.1) * (1 - .10 * ys) + 255 * .06 * ys
    glare = np.exp(-(np.hypot(np.arange(w)[None, :] - (W - 70) * u, np.arange(h)[:, None] - 50 * u) / (140 * u)) ** 2)[..., None] * .55
    grad = grad + (255 - grad) * glare
    base = Image.fromarray(np.clip(np.broadcast_to(grad, (h, w, 3)), 0, 255).astype("uint8"), "RGB").convert("RGBA")
    ov = Image.new("RGBA", (w * s, h * s))

    def soft(draw_fn, blur):
        layer = Image.new("RGBA", ov.size, (255, 255, 255, 0))
        draw_fn(ImageDraw.Draw(layer))
        ov.alpha_composite(layer.filter(ImageFilter.GaussianBlur(blur * k)))

    # Faint scanlines and circuit traces.
    d = ImageDraw.Draw(ov)
    for y in range(0, 112, 4):
        d.line(B(0, y, W, y), fill=(255, 255, 255, 9), width=max(1, round(.6 * k)))
    rng = random.Random(11)
    for _ in range(11):
        y = rng.uniform(10, 102)
        x = rng.uniform(W * .34, W - 40)
        run, drop, tail_run = rng.uniform(30, 70), rng.choice((-14, -9, 9, 14)), rng.uniform(16, 40)
        pts = [(x, y), (x + run, y), (x + run + abs(drop), y + drop), (x + run + abs(drop) + tail_run, y + drop)]
        d.line([B(*p) if False else (round(p[0] * k), round(p[1] * k)) for p in pts], fill=(255, 255, 255, 42),
               width=max(1, round(.9 * k)), joint="curve")
        ex, ey = pts[-1]
        d.ellipse(B(ex - 1.8, ey - 1.8, ex + 1.8, ey + 1.8), outline=(255, 255, 255, 120), width=max(1, round(.9 * k)))

    # A halo of thin rings with gaps, behind the butterflies on the right.
    hx, hy = W - 70, 50
    soft(lambda g: g.ellipse(B(hx - 38, hy - 38, hx + 38, hy + 38), outline=(255, 255, 255, 120), width=round(5 * k)), 5)
    for radius_, alpha_, gaps in ((30, 150, ((20, 70), (110, 160), (200, 250), (290, 340))), (40, 90, ((0, 120), (180, 300))),
                                  (52, 55, ((30, 100), (210, 280)))):
        for a0, a1 in gaps:
            d.arc(B(hx - radius_, hy - radius_, hx + radius_, hy + radius_), a0, a1,
                  fill=(255, 255, 255, alpha_), width=max(1, round(1.3 * k)))

    flies = header_butterflies()

    def paste_fly(cx, cy, size, angle, idx, mirror):
        if not flies:
            return
        sprite = flies[idx % len(flies)]
        if mirror:
            sprite = sprite.transpose(Image.Transpose.FLIP_LEFT_RIGHT)
        side = max(8, round(size * k))
        sprite = sprite.resize((side, side), Image.Resampling.LANCZOS).rotate(angle, resample=Image.Resampling.BICUBIC, expand=True)
        layer = Image.new("RGBA", ov.size)
        layer.paste(sprite, (round(cx * k - sprite.width / 2), round(cy * k - sprite.height / 2)))
        ov.alpha_composite(layer)

    for fx, fy, size, angle, idx, mirror in banner_butterflies(W):
        paste_fly(fx, fy, size, angle, idx, mirror)

    # Little sparkles.
    def sparkle(x, y, r):
        soft(lambda g: g.ellipse(B(x - r, y - r, x + r, y + r), fill=(255, 255, 255, 140)), r * .5)
        pts = [(0, -1), (.2, -.2), (1, 0), (.2, .2), (0, 1), (-.2, .2), (-1, 0), (-.2, -.2)]
        ImageDraw.Draw(ov).polygon([B(x + px * r, y + py * r) for px, py in pts], fill=(255, 255, 255, 240))

    sparkle(max(W * .585, 345), 17, 5)
    sparkle(W - 100, 64, 4)
    sparkle(max(W * .405, 270), 14, 3.5)
    sparkle(W - 18, 20, 4.5)

    # Diagonal gloss across the top-left of the banner.
    gl = Image.new("RGBA", ov.size)
    ImageDraw.Draw(gl).polygon([B(0, 0), B(W, 0), B(W, 18), B(0, 64)], fill=(255, 255, 255, 40))
    ov.alpha_composite(gl)

    ov = ov.resize((w, h), Image.Resampling.LANCZOS)
    base.alpha_composite(ov)

    # Rounded corners (the corners show the card color) and a thin glassy edge.
    mask = Image.new("L", (w * s, h * s))
    ImageDraw.Draw(mask).rounded_rectangle((0, 0, w * s - 1, h * s - 1), radius=radius * s, fill=255)
    base.putalpha(mask.resize((w, h), Image.Resampling.LANCZOS))
    out = Image.new("RGBA", (w, h), tuple(bg_rgb) + (255,))
    out.alpha_composite(base)
    rim = Image.new("RGBA", (w * s, h * s))
    rd = ImageDraw.Draw(rim)
    rd.rounded_rectangle((0, 0, w * s - 1, h * s - 1), radius=radius * s, outline=(48, 138, 196, 210), width=s)
    rd.rounded_rectangle((s, s, w * s - 1 - s, h * s - 1 - s), radius=(radius - 1) * s, outline=(255, 255, 255, 140), width=s)
    out.alpha_composite(rim.resize((w, h), Image.Resampling.LANCZOS))
    return out




def aero_scrollbar_image(thumb=True, active=False):
    """Aqua capsule: horizontally shaded, with a continuous vertical reflection."""
    from PIL import Image, ImageDraw
    import math
    width, height, scale = 20, 42, 4
    image = Image.new("RGBA", (width * scale, height * scale))
    draw = ImageDraw.Draw(image)
    for x in range(width * scale):
        t = x / (width * scale - 1)
        if thumb:
            base = (52, 168, 230) if not active else (76, 190, 242)
            shine = .72 * math.exp(-((t - .30) / .16) ** 2) + .16 * math.exp(-((t - .66) / .24) ** 2)
            rgb = tuple(round(c + (255 - c) * min(1, shine)) for c in base)
        else:
            shine = .75 * math.exp(-((t - .46) / .30) ** 2)
            rgb = tuple(round(c + (255 - c) * shine) for c in (190, 220, 234))
        draw.line((x, 0, x, height * scale - 1), fill=rgb + (255,))
    mask = Image.new("L", image.size)
    ImageDraw.Draw(mask).rounded_rectangle((2 * scale, scale, 18 * scale - 1, 41 * scale - 1), radius=8 * scale, fill=255)
    image.putalpha(mask)
    rim = Image.new("RGBA", image.size)
    rd = ImageDraw.Draw(rim)
    rd.rounded_rectangle((2 * scale, scale, 18 * scale - 1, 41 * scale - 1), radius=8 * scale,
                         outline=(40, 128, 190, 220) if thumb else (140, 184, 206, 150), width=scale)
    rd.rounded_rectangle((3 * scale, 2 * scale, 17 * scale - 1, 40 * scale - 1), radius=7 * scale,
                         outline=(240, 252, 255, 140), width=scale)
    image.alpha_composite(rim)
    return image.resize((width, height), Image.Resampling.LANCZOS)


