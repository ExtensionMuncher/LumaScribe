def _ease(p):
    p = min(1.0, max(0.0, p))
    return 1 - (1 - p) ** 3


def _seg(t, a, b):
    return (t - a) / float(b - a)


def _lut(factor):
    factor = min(1.0, max(0.0, factor))
    return [int(v * factor) for v in range(256)]


def _title_font(size):
    from PIL import ImageFont
    for name in ("segoeuiz.ttf", "arialbi.ttf", "DejaVuSans-BoldOblique.ttf", "FreeSansBoldOblique.ttf"):
        try:
            return ImageFont.truetype(name, size)
        except OSError:
            continue
    return ImageFont.load_default(size)


def _title_plain(text, width, height, dpi):
    """Big italic title with a navy outline and drop shadow, plus a blurred glow mask."""
    from PIL import Image, ImageDraw, ImageFilter
    font = _title_font(max(24, round(height * .112)))
    sw, sh = max(2, round(4 * dpi)), max(3, round(5 * dpi))
    pad = round(46 * dpi)
    probe = ImageDraw.Draw(Image.new("L", (8, 8)))
    box = probe.textbbox((0, 0), text, font=font, stroke_width=sw)
    tw, th = box[2] - box[0] + 2 * pad + sh, box[3] - box[1] + 2 * pad + sh
    img = Image.new("RGBA", (tw, th))
    d = ImageDraw.Draw(img)
    at = (pad - box[0], pad - box[1])
    d.text((at[0] + sh, at[1] + sh), text, font=font, fill=(10, 42, 140, 255), stroke_width=sw, stroke_fill=(10, 42, 140, 255))
    d.text(at, text, font=font, fill=(255, 255, 255, 255), stroke_width=sw, stroke_fill=(10, 42, 140, 255))
    alpha = img.getchannel("A")
    glow = alpha.filter(ImageFilter.GaussianBlur(14 * dpi)).point(lambda v: min(255, int(v * 2.2)))
    pos = ((width - tw) // 2, round(height * .49 - th / 2))
    return img.convert("RGB"), alpha, glow, pos


