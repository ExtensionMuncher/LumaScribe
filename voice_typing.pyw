MODIFIERS = ("ctrl", "alt", "shift", "windows")
MODIFIER_ALIASES = {"control": "ctrl", "win": "windows", "super": "windows"}


def parse_recording_hotkey(text, keyboard):
    """Accept one non-keypad key, optionally preceded by modifiers."""
    if not isinstance(text, str):
        raise ValueError("Enter a key or combination, such as F8 or Ctrl+Space.")
    parts = [MODIFIER_ALIASES.get(p.strip().lower(), p.strip().lower()) for p in text.split("+")]
    if not parts or any(not p for p in parts) or parts[-1] in MODIFIERS:
        raise ValueError("Include a main key, such as F8 or Ctrl+Space.")
    if any(p not in MODIFIERS for p in parts[:-1]) or len(set(parts[:-1])) != len(parts[:-1]):
        raise ValueError("Use one main key with optional Ctrl, Alt, Shift or Windows modifiers.")
    try:
        codes = frozenset(keyboard.key_to_scan_codes(parts[-1]))
    except (ValueError, TypeError, KeyError) as exc:
        raise ValueError("Unknown key. Try Insert, F8, F12 or Ctrl+Space.") from exc
    if not codes or any(keyboard.is_modifier(code) for code in codes):
        raise ValueError("Choose a main key other than a modifier.")
    modifiers = frozenset(parts[:-1])
    labels = {"ctrl": "Ctrl", "alt": "Alt", "shift": "Shift", "windows": "Windows"}
    label = "+".join([labels[m] for m in MODIFIERS if m in modifiers] + [parts[-1].title()])
    return label, codes, modifiers


class RecordingTrigger:
    """Filter physical keypad events before reserving any recording key."""
    def __init__(self, keyboard, callback, gate=None):
        self.keyboard, self.callback = keyboard, callback
        self.gate = gate or (lambda: True)  # lets a key pass through untouched while the gate is closed
        self.lock = Lock()
        self.paused = False
        self.generation = 0
        self.consumed = {}
        self.passed = set()

    def configure(self, config, numpad_zero):
        with self.lock:
            self.label, self.codes, self.modifiers = config
            self.numpad_zero = bool(numpad_zero)
            self.generation += 1

    def handle(self, event):
        physical = (event.scan_code, event.is_keypad)
        fire = False
        with self.lock:
            if event.event_type == self.keyboard.KEY_UP:
                self.passed.discard(physical)
                generation = self.consumed.pop(physical, None)
                if generation is None:
                    return True
                fire = not self.paused and generation == self.generation
            elif event.event_type == self.keyboard.KEY_DOWN:
                if physical in self.consumed:
                    return False  # Ignore auto-repeat until release.
                if self.paused or physical in self.passed or not self.gate():
                    self.passed.add(physical)
                    return True
                held = frozenset(m for m in MODIFIERS if self.keyboard.is_pressed(m))
                main = event.is_keypad is False and event.scan_code in self.codes and held == self.modifiers
                # Windows scan code 82 is keypad 0 / Insert in either Num Lock state.
                keypad = self.numpad_zero and event.is_keypad is True and event.scan_code == 82 and not held
                if not (main or keypad):
                    self.passed.add(physical)
                    return True
                self.consumed[physical] = self.generation
            else:
                return True
        if fire:
            self.callback()
        return False


class HotkeyCapture:
    """Collect a physical key chord without firing either app hotkey."""
    def __init__(self, keyboard):
        self.keyboard = keyboard
        self.lock = Lock()
        self.active = False
        self.consumed = set()
        self.candidate = None
        self.modifiers = {}
        self.initial_modifiers = set()
        self.results = Queue()

    def arm(self):
        with self.lock:
            self.active = True
            self.candidate = None
            self.initial_modifiers = {m for m in MODIFIERS if self.keyboard.is_pressed(m)}
            while not self.results.empty():
                self.results.get_nowait()

    def cancel(self):
        with self.lock:
            self.active = False
            self.candidate = None

    def handle(self, event):
        physical = (event.scan_code, event.is_keypad)
        with self.lock:
            name = (event.name or "").lower().removeprefix("left ").removeprefix("right ")
            modifier = MODIFIER_ALIASES.get(name, name)
            if event.event_type == self.keyboard.KEY_UP and modifier in MODIFIERS:
                self.modifiers.pop(physical, None)
                self.initial_modifiers.discard(modifier)
            if event.event_type == self.keyboard.KEY_UP and physical in self.consumed:
                self.consumed.discard(physical)
                if self.active and self.candidate and self.candidate[0] == physical:
                    self.results.put(("captured", self.candidate[1]))
                    self.active = False
                    self.candidate = None
                return False
            if event.event_type == self.keyboard.KEY_DOWN and physical in self.consumed:
                return False
            if not self.active:
                return None  # let the normal hotkey filters handle this event
            if event.event_type != self.keyboard.KEY_DOWN:
                return False
            self.consumed.add(physical)
            if self.keyboard.is_modifier(event.scan_code):
                if modifier in MODIFIERS:
                    self.modifiers[physical] = modifier
                return False
            if self.candidate:
                return False
            if event.is_keypad:
                self.results.put(("error", "Use a key outside the keypad. Numpad 0 has its own toggle below."))
                return False
            name = event.name
            if not isinstance(name, str) or name == "+":
                self.results.put(("error", "That key cannot be bound. Try another key."))
                return False
            # Blocking hooks run before keyboard's pressed-key table is updated.
            # Track suppressed modifier events ourselves, including both sides.
            held_modifiers = self.initial_modifiers | set(self.modifiers.values())
            held = [m for m in MODIFIERS if m in held_modifiers]
            try:
                config = parse_recording_hotkey("+".join(held + [name]), self.keyboard)
                if event.scan_code not in config[1]:
                    raise ValueError("This key cannot be identified reliably. Try another key.")
            except (ValueError, TypeError) as exc:
                self.results.put(("error", str(exc)))
                return False
            self.candidate = (physical, config[0])
            return False


def release_version(value):
    """Stable release tags use vMAJOR.MINOR.PATCH."""
    match = re.fullmatch(r"v?(\d+)\.(\d+)\.(\d+)", str(value))
    if not match:
        raise ValueError("Release tags must use vMAJOR.MINOR.PATCH, for example v0.1.1.")
    return tuple(int(n) for n in match.groups())


def check_latest_release():
    import urllib.request
    import urllib.error
    request = urllib.request.Request(
        f"https://api.github.com/repos/{UPDATE_REPO}/releases/latest",
        headers={"Accept": "application/vnd.github+json", "User-Agent": f"LumaScribe/{APP_VERSION}",
                 "X-GitHub-Api-Version": "2022-11-28"})
    try:
        with urllib.request.urlopen(request, timeout=15) as response:
            data = response.read(1024 * 1024 + 1)
        if len(data) > 1024 * 1024:
            raise ValueError("The release response was too large.")
        release = json.loads(data)
    except urllib.error.HTTPError as exc:
        if exc.code == 404:
            raise ValueError("No public release is available yet. The repository may be private or have no published Releases.") from exc
        if exc.code in (403, 429):
            raise ValueError("GitHub's request limit was reached. Please try again later.") from exc
        raise ValueError(f"GitHub returned HTTP {exc.code}.") from exc
    if not isinstance(release, dict) or release.get("draft") or release.get("prerelease"):
        raise ValueError("No stable public release was found.")
    version = release_version(release.get("tag_name"))
    if version <= release_version(APP_VERSION):
        return None
    filename = f"LumaScribe-v{'.'.join(map(str, version))}-Windows.zip"
    for asset in release.get("assets", []):
        if isinstance(asset, dict) and asset.get("name") == filename:
            return {"version": '.'.join(map(str, version)), "asset": asset}
    raise ValueError(f"The newer release is missing its Windows download: {filename}.")


def download_release(asset, destination, closing):
    """Download a repo-owned release ZIP; never execute or unpack it automatically."""
    import hashlib
    import urllib.request
    import urllib.parse
    import zipfile
    allowed_redirect_hosts = {"github.com", "release-assets.githubusercontent.com", "objects.githubusercontent.com"}

    class ReleaseRedirect(urllib.request.HTTPRedirectHandler):
        def redirect_request(self, req, fp, code, msg, headers, newurl):
            url = urllib.parse.urlsplit(newurl)
            if url.scheme != "https" or url.hostname not in allowed_redirect_hosts or url.username or url.password or url.port not in (None, 443):
                raise ValueError("The release download redirected outside GitHub's download servers.")
            return super().redirect_request(req, fp, code, msg, headers, newurl)

    url = asset.get("browser_download_url", "")
    parsed = urllib.parse.urlsplit(url)
    prefix = f"/{UPDATE_REPO}/releases/download/"
    if parsed.scheme != "https" or parsed.netloc != "github.com" or not parsed.path.startswith(prefix) or parsed.query or parsed.fragment:
        raise ValueError("The update download does not belong to the configured repository.")
    if any(part in (".", "..") for part in urllib.parse.unquote(parsed.path).split("/")):
        raise ValueError("Invalid release download path.")
    expected = asset.get("digest")
    if expected and not re.fullmatch(r"sha256:[0-9a-fA-F]{64}", expected):
        raise ValueError("The release checksum format is unsupported.")
    limit = UPDATE_SIZE_LIMIT
    advertised_size = asset.get("size")
    if not isinstance(advertised_size, int) or not 0 < advertised_size <= limit:
        raise ValueError("The release download size is invalid or exceeds 1 GiB.")
    destination = Path(destination)
    staging = None
    try:
        with tempfile.NamedTemporaryFile(prefix="lumascribe_update_", suffix=".part",
                                         dir=str(destination.parent), delete=False) as out:
            staging = Path(out.name)
            digest, count = hashlib.sha256(), 0
            request = urllib.request.Request(url, headers={"User-Agent": f"LumaScribe/{APP_VERSION}"})
            with urllib.request.build_opener(ReleaseRedirect()).open(request, timeout=20) as response:
                while True:
                    if closing.is_set():
                        raise ValueError("Download cancelled because LumaScribe is closing.")
                    block = response.read(64 * 1024)
                    if not block:
                        break
                    count += len(block)
                    if count > limit or count > advertised_size:
                        raise ValueError("The download exceeded its declared size.")
                    digest.update(block)
                    out.write(block)
        if count != advertised_size:
            raise ValueError("The update download was incomplete.")
        if expected and digest.hexdigest().lower() != expected.split(":", 1)[1].lower():
            raise ValueError("The update checksum did not match. Nothing was installed.")
        with zipfile.ZipFile(staging) as archive:
            files = archive.infolist()
            if not files or len(files) > 200 or sum(f.file_size for f in files) > limit:
                raise ValueError("The update ZIP is empty or too large.")
            if archive.testzip() is not None:
                raise ValueError("The update ZIP is damaged.")
            names = set(archive.namelist())
            if "LumaScribe/voice_typing.pyw" not in names or "LumaScribe/Open_LumaScribe.bat" not in names:
                raise ValueError("The ZIP is not a complete LumaScribe release.")
            for item in files:
                name = item.filename.replace("\\", "/")
                if name.startswith("/") or ":" in name or ".." in name.split("/") or (item.external_attr >> 16) & 0o170000 == 0o120000:
                    raise ValueError("The ZIP contains an unsafe path.")
        if closing.is_set():
            raise ValueError("Download cancelled because LumaScribe is closing.")
        os.replace(staging, destination)
    finally:
        if staging is not None:
            staging.unlink(missing_ok=True)


_opening_audio_cache = {}


def opening_audio_file():
    """Keep one complete WAV alive until playback is explicitly stopped."""
    import numpy as np
    cached = _opening_audio_cache.get("path")
    if cached is not None and cached.is_file():
        return cached
    with wave.open(str(asset_path(TUNE_WAV)), "rb") as tune, wave.open(str(asset_path(VOICE_WAV)), "rb") as voice:
        rate = tune.getframerate()
        if (tune.getsampwidth() != 2 or voice.getsampwidth() != 2 or
                voice.getframerate() != rate or tune.getnchannels() not in (1, 2) or
                voice.getnchannels() not in (1, 2)):
            raise ValueError("Opening WAV files must be 16-bit PCM at the same sample rate.")
        def stereo(wav):
            samples = np.frombuffer(wav.readframes(wav.getnframes()), dtype="<i2").reshape(-1, wav.getnchannels())
            return np.repeat(samples, 2, axis=1) if wav.getnchannels() == 1 else samples
        music, speech = stereo(tune), stereo(voice)
    # A short silent separation replaces the fragile PlaySound-to-PlaySound handoff.
    gap = max(round(rate * .080), round(rate * 2.0) - len(music))
    handle = tempfile.NamedTemporaryFile(prefix="lumascribe_opening_", suffix=".wav", delete=False)
    path = Path(handle.name)
    handle.close()  # Windows must be able to open the file independently.
    try:
        with wave.open(str(path), "wb") as out:
            out.setnchannels(2)
            out.setsampwidth(2)
            out.setframerate(rate)
            out.writeframes(music.tobytes() + bytes(gap * 4) + speech.tobytes())
    except Exception:
        path.unlink(missing_ok=True)
        raise
    _opening_audio_cache.update(path=path, voice_ms=(len(music) + gap) * 1000.0 / rate,
                               duration_ms=(len(music) + gap + len(speech)) * 1000.0 / rate)
    return path


def opening_sound(play=False, name=None):
    """Start the full opening once; report failure so the caller can retry."""
    try:
        import winsound
        if play:
            sound = asset_path(name) if name else opening_audio_file()
            if not sound.is_file():
                return False
            winsound.PlaySound(str(sound), winsound.SND_FILENAME | winsound.SND_ASYNC | winsound.SND_NODEFAULT)
        else:
            winsound.PlaySound(None, 0)
            cached = _opening_audio_cache.pop("path", None)
            if cached is not None:
                cached.unlink(missing_ok=True)
            _opening_audio_cache.clear()
        return True
    except (ImportError, OSError, RuntimeError, ValueError, wave.Error, EOFError):
        return False



import atexit
atexit.register(opening_sound)


def wav_length_ms(name, default):
    try:
        with wave.open(str(asset_path(name)), "rb") as w:
            return w.getnframes() * 1000.0 / w.getframerate()
    except (OSError, wave.Error, EOFError):
        return default


_portrait_cache = {}
_fly_cache = []


def header_butterflies():
    """Two butterflies cut from the portrait artwork, used in the menu header."""
    if not _fly_cache:
        import base64
        import io
        from PIL import Image
        for data in BUTTERFLY_B64:
            _fly_cache.append(Image.open(io.BytesIO(base64.b64decode(data))).convert("RGBA"))
    return _fly_cache


def portrait_content_bounds(portrait):
    """Measure the head and visible fade, rather than the transparent PNG canvas."""
    import numpy as np
    alpha = np.asarray(portrait.getchannel("A"))
    height, width = alpha.shape
    # Ignore isolated butterflies and the light streak above her head. The central
    # opaque mass marks the character's crown; 25% alpha marks the visible fade end.
    core = alpha[:, round(width * .23):round(width * .60)]
    head_rows = np.flatnonzero((core >= 192).sum(axis=1) >= max(1, round(width * .028)))
    fade_rows = np.flatnonzero((alpha >= 64).any(axis=1))
    if not len(head_rows) or not len(fade_rows):
        return 0.0, 1.0
    top, bottom = int(head_rows[0]), int(fade_rows[-1]) + 1
    if bottom <= top:
        return 0.0, 1.0
    return top / height, bottom / height


def compute_layout(w, h, dpi, has_portrait, portrait_ratio=PORTRAIT_RATIO,
                   content_bounds=(0.0, 1.0)):
    """Align crown/fade with the card; tuck the fading hair edge just under it."""
    margin, bottom = round(22 * dpi), round(54 * dpi)
    y0, y1 = margin, h - bottom
    top_fraction, bottom_fraction = content_bounds
    visible_fraction = max(.1, bottom_fraction - top_fraction)
    ph = max(2, round((y1 - y0) / visible_fraction)) if has_portrait else 0
    py = y0 - round(ph * top_fraction) if has_portrait else y0
    pw = round(ph * portrait_ratio)
    gap = -round((y1 - y0) * PORTRAIT_FADE_OVERLAP) if has_portrait else 0
    card_w = max(2, min(w - 2 * margin - pw - gap, round(CARD_MAX_W * dpi)))
    left = max(margin, (w - pw - gap - card_w) // 2)
    return {"px": left, "py": py, "pw": pw, "ph": ph,
            "box": (left + pw + gap, y0, left + pw + gap + card_w, y1)}


def portrait_glow_sprites(portrait, lay, levels=20):
    """Soft glows for the portrait's butterflies at several brightnesses: (x, y, [frames]) in window pixels."""
    from PIL import Image
    import numpy as np
    out = []
    if portrait is None:
        return out
    pw, ph = portrait.size
    alpha = portrait.getchannel("A")
    card_x = lay["box"][0]
    for fx, fy, fr in PORTRAIT_FLIES:
        cx, cy = fx * pw, fy * ph
        radius = max(14, round(fr * ph * 3.8))
        side = radius * 2
        left, top = lay["px"] + cx - radius, lay["py"] + cy - radius
        cl, ct, cr = max(0, round(-left)), max(0, round(-top)), min(side, round(card_x - 2 - left))
        if cr - cl < 6:
            continue
        yy, xx = np.mgrid[0:side, 0:side]
        shape = np.clip(1 - np.hypot(xx - radius, yy - radius) / radius, 0, 1) ** 1.9
        frames = []
        for i in range(levels):
            arr = np.zeros((side, side, 4), dtype="uint8")
            arr[..., 0], arr[..., 1], arr[..., 2] = 255, 255, 255
            arr[..., 3] = (shape * (.92 * i / (levels - 1)) * 255).astype("uint8")
            frames.append(Image.fromarray(arr, "RGBA").crop((cl, ct, cr, side)))
        out.append((round(left + cl), round(top + ct), frames))
    return out


def load_portrait(height):
    """The complete character portrait scaled to the card height (None if the file is missing)."""
    from PIL import Image
    path = asset_path(PORTRAIT_FILE)
    if not path.is_file():
        return None
    try:
        if "src" not in _portrait_cache:
            _portrait_cache["src"] = Image.open(path).convert("RGBA")
        height = max(2, int(height))
        if _portrait_cache.get("h") != height:
            src = _portrait_cache["src"]
            _portrait_cache["img"] = src.resize((max(2, round(src.width * height / src.height)), height), Image.Resampling.LANCZOS)
            _portrait_cache["h"] = height
        return _portrait_cache["img"]
    except (OSError, ValueError):
        return None


