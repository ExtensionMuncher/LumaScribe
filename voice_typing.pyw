def aero_button_image(look, state="normal", width=80, height=44):
    """Glossy gel button. The middle row is a single pixel so ttk never shows tiling stripes."""
    from PIL import Image, ImageChops, ImageDraw, ImageFilter
    top0, top1, low0, low1, glow, rim = _BUTTON_LOOKS[(look, state)]
    s = 4
    split = height // 2
    radius = 8 if height <= 36 else 11
    image = Image.new("RGBA", (width * s, height * s))
    draw = ImageDraw.Draw(image)
    for y in range(height * s):
        py = y / s
        if py < split:
            rgb = _mix(top0, top1, (py / split) ** .9)
        else:
            rgb = _mix(low0, low1, ((py - split) / (height - split)) ** 1.5)
            # Light bouncing up from the bottom edge (uniform across the width so ttk can stretch it cleanly).
            rgb = _mix(rgb, glow, .62 * max(0.0, (py - (height - 12)) / 12) ** 1.6)
        draw.line((0, y, width * s - 1, y), fill=rgb + (255,))
    mask = Image.new("L", image.size)
    box = (s, s, (width - 1) * s - 1, (height - 1) * s - 1)
    ImageDraw.Draw(mask).rounded_rectangle(box, radius=radius * s, fill=255)
    image.putalpha(ImageChops.multiply(image.getchannel("A"), mask))
    edge = Image.new("RGBA", image.size)
    ed = ImageDraw.Draw(edge)
    ed.rounded_rectangle(box, radius=radius * s, outline=rim + (240,), width=s)
    ed.rounded_rectangle((2 * s, 2 * s, (width - 2) * s - 1, (height - 2) * s - 1), radius=(radius - 1) * s,
                         outline=(255, 255, 255, 60 if look == "primary" else 110), width=s)
    image.alpha_composite(edge)
    return image.resize((width, height), Image.Resampling.LANCZOS)


def aero_check_image(checked, active):
    """Small glass checkbox; checked boxes are filled with blue gel and a white tick."""
    from PIL import Image, ImageChops, ImageDraw
    n, s = 22, 4
    image = Image.new("RGBA", (n * s, n * s))
    draw = ImageDraw.Draw(image)
    for y in range(n * s):
        t = y / (n * s - 1)
        if checked:
            rgb = _mix((140, 220, 252), (52, 164, 230), t / .5) if t < .5 else _mix((20, 124, 204), (70, 200, 246), (t - .5) / .5)
        else:
            rgb = _mix((255, 255, 255), (206, 236, 250) if not active else (176, 228, 250), t)
        draw.line((0, y, n * s - 1, y), fill=rgb + (255,))
    box = (2 * s, 2 * s, 20 * s - 1, 20 * s - 1)
    mask = Image.new("L", image.size)
    ImageDraw.Draw(mask).rounded_rectangle(box, radius=5 * s, fill=255)
    image.putalpha(ImageChops.multiply(image.getchannel("A"), mask))
    edge = Image.new("RGBA", image.size)
    ed = ImageDraw.Draw(edge)
    ed.rounded_rectangle(box, radius=5 * s, outline=((10, 88, 152, 235) if checked else (84, 154, 198, 235)), width=s)
    ed.rounded_rectangle((3 * s, 3 * s, 19 * s - 1, 19 * s - 1), radius=4 * s, outline=(255, 255, 255, 170), width=s)
    image.alpha_composite(edge)
    if checked:
        tick = [(6.3, 11.6), (9.8, 15.0), (16.0, 7.4)]
        d = ImageDraw.Draw(image)
        d.line([(x * s, (y + .9) * s) for x, y in tick], fill=(0, 70, 130, 150), width=round(2.6 * s), joint="curve")
        d.line([(x * s, y * s) for x, y in tick], fill=(255, 255, 255, 255), width=round(2.6 * s), joint="curve")
    return image.resize((n, n), Image.Resampling.LANCZOS)


